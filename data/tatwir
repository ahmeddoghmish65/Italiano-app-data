        <i data-lucide="check-circle" width="20" height="20"></i>
        <span>تم حفظ الكلمة بنجاح!</span>
    </div>

    <script>
        // Initialize Lucide Icons
        lucide.createIcons();

        // Page Navigation
        function showPage(pageId, navItem) {
            // Hide all pages
            document.querySelectorAll('.page').forEach(page => {
                page.classList.remove('active');
            });
            
            // Show selected page
            document.getElementById(pageId).classList.add('active');
            
            // Update nav items
            if (navItem) {
                document.querySelectorAll('.nav-item').forEach(item => {
                    item.classList.remove('active');
                });
                navItem.classList.add('active');
            }
            
            // Scroll to top
            window.scrollTo(0, 0);
        }

        // Quiz Option Selection
        function selectOption(element) {
            document.querySelectorAll('.quiz-option').forEach(opt => {
                opt.classList.remove('selected');
            });
            element.classList.add('selected');
        }

        // Show Toast
        function showToast(message, type = 'success') {
            const toast = document.getElementById('toast');
            toast.querySelector('span').textContent = message;
            toast.className = `toast ${type} show`;
            
            setTimeout(() => {
                toast.classList.remove('show');
            }, 3000);
        }

        // Add ripple effect to buttons
        document.querySelectorAll('.btn, .lesson-card, .level-card').forEach(el => {
            el.classList.add('ripple');
        });

        // Simulate progress animation on load
        document.addEventListener('DOMContentLoaded', () => {
            setTimeout(() => {
                document.querySelectorAll('.progress-bar-fill, .level-progress-fill').forEach(bar => {
                    const width = bar.style.width;
                    bar.style.width = '0%';
                    setTimeout(() => {
                        bar.style.width = width;
                    }, 100);
                });
            }, 300);
        });
    </script>

