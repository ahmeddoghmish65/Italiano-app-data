<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Italiano - تعلم الإيطالية</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <style>
        /* ============================================
           🎨 CSS Variables - نظام الألوان والمتغيرات
           ============================================ */
        :root {
            /* Primary Colors - ألوان العلم الإيطالي */
            --italian-green: #009246;
            --italian-white: #F4F5F0;
            --italian-red: #CE2B37;
            
            /* App Colors */
            --primary: #009246;
            --primary-light: #E8F5E9;
            --primary-dark: #007A3D;
            
            --secondary: #2196F3;
            --secondary-light: #E3F2FD;
            
            --accent: #FF9800;
            --accent-light: #FFF3E0;
            
            --success: #4CAF50;
            --warning: #FFC107;
            --error: #F44336;
            
            /* Neutrals */
            --bg-primary: #FAFBFC;
            --bg-secondary: #FFFFFF;
            --bg-card: #FFFFFF;
            
            --text-primary: #1A1A2E;
            --text-secondary: #64748B;
            --text-muted: #94A3B8;
            
            --border-light: #E2E8F0;
            --border-medium: #CBD5E1;
            
            /* Shadows */
            --shadow-sm: 0 1px 2px rgba(0,0,0,0.05);
            --shadow-md: 0 4px 6px -1px rgba(0,0,0,0.1);
            --shadow-lg: 0 10px 15px -3px rgba(0,0,0,0.1);
            --shadow-xl: 0 20px 25px -5px rgba(0,0,0,0.1);
            --shadow-card: 0 2px 8px rgba(0,0,0,0.08);
            --shadow-card-hover: 0 8px 25px rgba(0,0,0,0.15);
            
            /* Spacing */
            --space-xs: 4px;
            --space-sm: 8px;
            --space-md: 16px;
            --space-lg: 24px;
            --space-xl: 32px;
            --space-2xl: 48px;
            
            /* Border Radius */
            --radius-sm: 8px;
            --radius-md: 12px;
            --radius-lg: 16px;
            --radius-xl: 24px;
            --radius-full: 50%;
            
            /* Typography */
            --font-ar: 'Cairo', sans-serif;
            --font-en: 'Poppins', sans-serif;
            
            /* Transitions */
            --transition-fast: 0.15s ease;
            --transition-normal: 0.3s ease;
            --transition-slow: 0.5s ease;
            
            /* Layout */
            --header-height: 60px;
            --bottom-nav-height: 70px;
            --safe-area-bottom: env(safe-area-inset-bottom, 0px);
        }

        /* ============================================
           🔄 Reset & Base Styles
           ============================================ */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            -webkit-tap-highlight-color: transparent;
        }

        html {
            scroll-behavior: smooth;
            -webkit-text-size-adjust: 100%;
        }

        body {
            font-family: var(--font-ar);
            background: var(--bg-primary);
            color: var(--text-primary);
            line-height: 1.6;
            min-height: 100vh;
            overflow-x: hidden;
            padding-bottom: calc(var(--bottom-nav-height) + var(--safe-area-bottom) + 20px);
        }

        /* ============================================
           📱 Header - الشريط العلوي
           ============================================ */
        .app-header {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            height: var(--header-height);
            background: var(--bg-secondary);
            border-bottom: 1px solid var(--border-light);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 var(--space-md);
            z-index: 1000;
            backdrop-filter: blur(10px);
            background: rgba(255,255,255,0.95);
        }

        .header-logo {
            display: flex;
            align-items: center;
            gap: var(--space-sm);
        }

        .header-logo img {
            width: 36px;
            height: 36px;
            border-radius: var(--radius-sm);
        }

        .header-logo-placeholder {
            width: 36px;
            height: 36px;
            background: linear-gradient(135deg, var(--italian-green), var(--italian-red));
            border-radius: var(--radius-sm);
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-weight: 700;
            font-size: 14px;
        }

        .header-title {
            font-size: 18px;
            font-weight: 700;
            color: var(--text-primary);
        }

        .header-stats {
            display: flex;
            align-items: center;
            gap: var(--space-md);
        }

        .stat-item {
            display: flex;
            align-items: center;
            gap: 4px;
            font-size: 14px;
            font-weight: 600;
        }

        .stat-item.streak {
            color: var(--accent);
        }

        .stat-item.xp {
            color: var(--secondary);
        }

        .stat-icon {
            width: 20px;
            height: 20px;
        }

        /* ============================================
           📄 Main Content Area
           ============================================ */
        .main-content {
            padding-top: calc(var(--header-height) + var(--space-md));
            padding-left: var(--space-md);
            padding-right: var(--space-md);
            max-width: 480px;
            margin: 0 auto;
        }

        /* ============================================
           🎯 Daily Goal Card
           ============================================ */
        .daily-goal-card {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            border-radius: var(--radius-lg);
            padding: var(--space-lg);
            color: white;
            margin-bottom: var(--space-lg);
            position: relative;
            overflow: hidden;
        }

        .daily-goal-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 100%;
            height: 100%;
            background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
            pointer-events: none;
        }

        .goal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: var(--space-md);
        }

        .goal-title {
            font-size: 14px;
            opacity: 0.9;
            font-weight: 500;
        }

        .goal-badge {
            background: rgba(255,255,255,0.2);
            padding: 4px 10px;
            border-radius: var(--radius-full);
            font-size: 12px;
            font-weight: 600;
        }

        .goal-progress {
            margin-bottom: var(--space-sm);
        }

        .progress-bar-bg {
            height: 8px;
            background: rgba(255,255,255,0.3);
            border-radius: var(--radius-full);
            overflow: hidden;
        }

        .progress-bar-fill {
            height: 100%;
            background: white;
            border-radius: var(--radius-full);
            transition: width var(--transition-slow);
            position: relative;
        }

        .progress-bar-fill::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
            animation: shimmer 2s infinite;
        }

        @keyframes shimmer {
            0% { transform: translateX(-100%); }
            100% { transform: translateX(100%); }
        }

        .goal-stats {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            opacity: 0.9;
        }

        /* ============================================
           📊 Quick Stats Section
           ============================================ */
        .quick-stats {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: var(--space-sm);
            margin-bottom: var(--space-lg);
        }

        .quick-stat-card {
            background: var(--bg-card);
            border-radius: var(--radius-md);
            padding: var(--space-md);
            text-align: center;
            box-shadow: var(--shadow-card);
            transition: all var(--transition-normal);
        }

        .quick-stat-card:active {
            transform: scale(0.98);
        }

        .quick-stat-icon {
            width: 40px;
            height: 40px;
            margin: 0 auto var(--space-sm);
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .quick-stat-icon.words {
            background: var(--primary-light);
            color: var(--primary);
        }

        .quick-stat-icon.lessons {
            background: var(--secondary-light);
            color: var(--secondary);
        }

        .quick-stat-icon.streak {
            background: var(--accent-light);
            color: var(--accent);
        }

        .quick-stat-value {
            font-size: 20px;
            font-weight: 700;
            color: var(--text-primary);
            margin-bottom: 2px;
        }

        .quick-stat-label {
            font-size: 11px;
            color: var(--text-secondary);
        }

        /* ============================================
           📚 Section Headers
           ============================================ */
        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: var(--space-md);
        }

        .section-title {
            font-size: 18px;
            font-weight: 700;
            color: var(--text-primary);
        }

        .section-link {
            font-size: 14px;
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 4px;
        }

        /* ============================================
           🎓 Level Cards - كروت المستويات
           ============================================ */
        .levels-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: var(--space-md);
            margin-bottom: var(--space-xl);
        }

        .level-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            padding: var(--space-lg);
            box-shadow: var(--shadow-card);
            position: relative;
            overflow: hidden;
            cursor: pointer;
            transition: all var(--transition-normal);
            text-decoration: none;
            color: inherit;
            display: block;
        }

        .level-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-card-hover);
        }

        .level-card:active {
            transform: translateY(-2px) scale(0.98);
        }

        .level-card.locked {
            opacity: 0.6;
            pointer-events: none;
        }

        .level-card.locked::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(255,255,255,0.5);
        }

        .level-badge {
            position: absolute;
            top: var(--space-sm);
            left: var(--space-sm);
            width: 44px;
            height: 44px;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 16px;
            color: white;
        }

        .level-badge.a1 { background: linear-gradient(135deg, #4CAF50, #2E7D32); }
        .level-badge.a2 { background: linear-gradient(135deg, #2196F3, #1565C0); }
        .level-badge.b1 { background: linear-gradient(135deg, #9C27B0, #6A1B9A); }
        .level-badge.b2 { background: linear-gradient(135deg, #FF5722, #D84315); }

        .level-content {
            margin-top: 50px;
        }

        .level-name {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .level-desc {
            font-size: 12px;
            color: var(--text-secondary);
            margin-bottom: var(--space-md);
        }

        .level-progress {
            display: flex;
            align-items: center;
            gap: var(--space-sm);
        }

        .level-progress-bar {
            flex: 1;
            height: 6px;
            background: var(--border-light);
            border-radius: var(--radius-full);
            overflow: hidden;
        }

        .level-progress-fill {
            height: 100%;
            background: var(--primary);
            border-radius: var(--radius-full);
            transition: width var(--transition-slow);
        }

        .level-progress-text {
            font-size: 12px;
            font-weight: 600;
            color: var(--text-secondary);
            min-width: 36px;
            text-align: left;
        }

        .level-lock-icon {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 10;
            color: var(--text-muted);
        }

        /* ============================================
           📖 Lesson Cards - كروت الدروس
           ============================================ */
        .lessons-list {
            display: flex;
            flex-direction: column;
            gap: var(--space-md);
            margin-bottom: var(--space-xl);
        }

        .lesson-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            padding: var(--space-md);
            box-shadow: var(--shadow-card);
            display: flex;
            align-items: center;
            gap: var(--space-md);
            cursor: pointer;
            transition: all var(--transition-normal);
            text-decoration: none;
            color: inherit;
            border: 2px solid transparent;
        }

        .lesson-card:hover {
            border-color: var(--primary-light);
            box-shadow: var(--shadow-card-hover);
        }

        .lesson-card:active {
            transform: scale(0.98);
        }

        .lesson-card.completed {
            border-color: var(--success);
            background: linear-gradient(to right, rgba(76, 175, 80, 0.05), transparent);
        }

        .lesson-card.current {
            border-color: var(--primary);
            background: linear-gradient(to right, var(--primary-light), transparent);
        }

        .lesson-icon {
            width: 52px;
            height: 52px;
            border-radius: var(--radius-md);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            flex-shrink: 0;
        }

        .lesson-icon.grammar { background: #E3F2FD; }
        .lesson-icon.vocab { background: #E8F5E9; }
        .lesson-icon.dialog { background: #FFF3E0; }
        .lesson-icon.exercise { background: #F3E5F5; }

        .lesson-info {
            flex: 1;
            min-width: 0;
        }

        .lesson-title {
            font-size: 15px;
            font-weight: 600;
            margin-bottom: 2px;
            display: -webkit-box;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .lesson-meta {
            display: flex;
            align-items: center;
            gap: var(--space-sm);
            font-size: 12px;
            color: var(--text-secondary);
        }

        .lesson-meta-item {
            display: flex;
            align-items: center;
            gap: 3px;
        }

        .lesson-status {
            width: 32px;
            height: 32px;
            border-radius: var(--radius-full);
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .lesson-status.completed {
            background: var(--success);
            color: white;
        }

        .lesson-status.current {
            background: var(--primary);
            color: white;
        }

        .lesson-status.locked {
            background: var(--border-light);
            color: var(--text-muted);
        }

        /* ============================================
           🔤 Word Cards - كروت الكلمات
           ============================================ */
        .words-section {
            margin-bottom: var(--space-xl);
        }

        .word-card {
            background: var(--bg-card);
            border-radius: var(--radius-lg);
            padding: var(--space-lg);
            margin-bottom: var(--space-md);
            box-shadow: var(--shadow-card);
            position: relative;
            overflow: hidden;
        }

        .word-card::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 4px;
            height: 100%;
            background: var(--primary);
        }

        .word-italian {
            font-family: var(--font-en);
            font-size: 24px;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: 4px;
        }

        .word-pronunciation {
            font-size: 14px;
            color: var(--text-muted);
            margin-bottom: var(--space-sm);
            font-style: italic;
        }

        .word-arabic {
            font-size: 18px;
            color: var(--text-primary);
            margin-bottom: var(--space-md);
        }

        .word-example {
            background: var(--bg-primary);
            border-radius: var(--radius-sm);
            padding: var(--space-md);
            margin-bottom: var(--space-md);
        }

        .word-example-it {
            font-family: var(--font-en);
            font-size: 14px;
            color: var(--text-primary);
            margin-bottom: 4px;
        }

        .word-example-ar {
            font-size: 13px;
            color: var(--text-secondary);
        }

        .word-actions {
            display: flex;
            gap: var(--space-sm);
        }

        .word-action-btn {
            flex: 1;
            padding: var(--space-sm) var(--space-md);
            border: none;
            border-radius: var(--radius-sm);
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            transition: all var(--transition-normal);
        }

        .word-action-btn.primary {
            background: var(--primary);
            color: white;
        }

        .word-action-btn.primary:active {
            background: var(--primary-dark);
        }

        .word-action-btn.secondary {
            background: var(--bg-primary);
            color: var(--text-primary);
            border: 1px solid var(--border-light);
        }

        .word-action-btn.secondary:active {
            background: var(--border-light);
        }

        /* ============================================
           🏆 Achievement Badges
           ============================================ */
        .achievements-scroll {
            display: flex;
            gap: var(--space-md);
            overflow-x: auto;
            padding-bottom: var(--space-md);
            margin-bottom: var(--space-lg);
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
        }

        .achievements-scroll::-webkit-scrollbar {
            display: none;
        }

        .achievement-badge {
            flex-shrink: 0;
            width: 80px;
            text-align: center;
        }

        .badge-icon {
            width: 60px;
            height: 60px;
            margin: 0 auto var(--space-sm);
            border-radius: var(--radius-full);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 28px;
            position: relative;
        }

        .badge-icon.earned {
            background: linear-gradient(135deg, #FFD700, #FFA000);
            box-shadow: 0 4px 15px rgba(255, 193, 7, 0.4);
        }

        .badge-icon.locked {
            background: var(--border-light);
            filter: grayscale(1);
            opacity: 0.5;
        }

        .badge-name {
            font-size: 11px;
            color: var(--text-secondary);
            font-weight: 500;
        }

        /* ============================================
           📍 Bottom Navigation
           ============================================ */
        .bottom-nav {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            height: calc(var(--bottom-nav-height) + var(--safe-area-bottom));
            background: var(--bg-secondary);
            border-top: 1px solid var(--border-light);
            display: flex;
            justify-content: space-around;
            align-items: flex-start;
            padding-top: var(--space-sm);
            padding-bottom: var(--safe-area-bottom);
            z-index: 1000;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            padding: var(--space-sm);
            color: var(--text-muted);
            text-decoration: none;
            transition: all var(--transition-fast);
            position: relative;
            min-width: 64px;
        }

        .nav-item.active {
            color: var(--primary);
        }

        .nav-item.active::before {
            content: '';
            position: absolute;
            top: -9px;
            left: 50%;
            transform: translateX(-50%);
            width: 32px;
            height: 3px;
            background: var(--primary);
            border-radius: 0 0 4px 4px;
        }

        .nav-item:active {
            transform: scale(0.95);
        }

        .nav-icon {
            width: 24px;
            height: 24px;
        }

        .nav-label {
            font-size: 11px;
            font-weight: 500;
        }

        /* ============================================
           🔘 Buttons
           ============================================ */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: var(--space-sm);
            padding: var(--space-md) var(--space-lg);
            border: none;
            border-radius: var(--radius-md);
            font-family: var(--font-ar);
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all var(--transition-normal);
            text-decoration: none;
        }

        .btn-primary {
            background: var(--primary);
            color: white;
        }

        .btn-primary:hover {
            background: var(--primary-dark);
        }

        .btn-primary:active {
            transform: scale(0.98);
        }

        .btn-secondary {
            background: var(--bg-primary);
            color: var(--text-primary);
            border: 1px solid var(--border-medium);
        }

        .btn-secondary:active {
            background: var(--border-light);
        }

        .btn-full {
            width: 100%;
        }

        .btn-lg {
            padding: var(--space-md) var(--space-xl);
            font-size: 16px;
        }

        /* ============================================
           🎴 Flashcard Style
           ============================================ */
        .flashcard-container {
            perspective: 1000px;
            margin-bottom: var(--space-xl);
        }

        .flashcard {
            background: var(--bg-card);
            border-radius: var(--radius-xl);
            padding: var(--space-2xl) var(--space-lg);
            min-height: 200px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            box-shadow: var(--shadow-lg);
            cursor: pointer;
            transition: transform var(--transition-normal);
            position: relative;
        }

        .flashcard:active {
            transform: scale(0.98);
        }

        .flashcard-word {
            font-family: var(--font-en);
            font-size: 32px;
            font-weight: 700;
            color: var(--primary);
            margin-bottom: var(--space-sm);
        }

        .flashcard-hint {
            font-size: 14px;
            color: var(--text-muted);
            display: flex;
            align-items: center;
            gap: var(--space-xs);
        }

        .flashcard-actions {
            display: flex;
            gap: var(--space-md);
            margin-top: var(--space-lg);
            width: 100%;
        }

        .flashcard-btn {
            flex: 1;
            padding: var(--space-md);
            border: none;
            border-radius: var(--radius-md);
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 4px;
            transition: all var(--transition-normal);
        }

        .flashcard-btn.wrong {
            background: #FFEBEE;
