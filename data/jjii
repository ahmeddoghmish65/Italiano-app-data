function getAllWords(){const w=[];Object.keys(DB.words).forEach(l=>{Object.entries(DB.words[l]).forEach(([cid,c])=>{c.words?.forEach(x=>w.push({...x,level:l,category:c.name,catId:cid}))})});return w}
