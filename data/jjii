// Voice Recognition
function initVoice(){if('webkitSpeechRecognition'in window||'SpeechRecognition'in window){const SR=window.SpeechRecognition||window.webkitSpeechRecognition;recog=new SR();recog.lang='it-IT';recog.continuous=false;recog.interimResults=false;recog.onresult=e=>{const r=e.results[0][0].transcript.toLowerCase();handleVoiceRes(r)};recog.onerror=()=>{stopVoice();toast('خطأ في التعرف على الصوت','error')};recog.onend=stopVoice}}
function toggleVoice(){if(!recog){toast('متصفحك لا يدعم التعرف على الصوت','warning');return}isListening?stopVoice():startVoice()}
function startVoice(){if(!recog)return;isListening=true;const btn=$('voiceBtn');btn.classList.add('listening');btn.innerHTML='<i class="fas fa-stop"></i>';$('voiceResult').style.display='none';try{recog.start()}catch(e){stopVoice()}}
function stopVoice(){isListening=false;const btn=$('voiceBtn');if(btn){btn.classList.remove('listening');btn.innerHTML='<i class="fas fa-microphone"></i>'}try{recog?.stop()}catch(e){}}
function handleVoiceRes(res){const q=quizQs[quizIdx];if(!q)return;const vr=$('voiceResult');vr.style.display='block';const correct=q.correct.toLowerCase().trim(),user=res.toLowerCase().trim();const ok=user===correct||user.includes(correct)||correct.includes(user)||calcSim(user,correct)>.7;if(ok){vr.innerHTML=`<span style="color:var(--success)">✓ صحيح! قلت: "${res}"</span>`;quizScore++;S.correct++;addXP(10);toast('✓ نطق ممتاز!','success')}else{vr.innerHTML=`<span style="color:var(--danger)">✗ قلت: "${res}"<br>الصحيح: "${q.correct}"</span>`;toast('حاول مرة أخرى','error')}S.totalQ++;$('quizNextBtn').style.display='block'}
function calcSim(a,b){const l=a.length>b.length?a:b,s=a.length>b.length?b:a;if(!l.length)return 1;const c=[];for(let i=0;i<=l.length;i++){let last=i;for(let j=0;j<=s.length;j++){if(i===0)c[j]=j;else if(j>0){let nv=c[j-1];if(l[i-1]!==s[j-1])nv=Math.min(nv,last,c[j])+1;c[j-1]=last;last=nv}}if(i>0)c[s.length]=last}return(l.length-c[s.length])/l.length}

