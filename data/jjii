function startMatching(){const words=getLevelWords().sort(()=>Math.random()-.5).slice(0,6);if(words.length<4){toast('لا توجد كلمات كافية','warning');return}matchCards=[];words.forEach(w=>{matchCards.push({id:w.it+'_it',text:w.it,pair:w.it,type:'it',matched:false});matchCards.push({id:w.it+'_ar',text:w.ar,pair:w.it,type:'ar',matched:false})});matchCards=matchCards.sort(()=>Math.random()-.5);firstCard=null;matchLock=false;matchCount=0;matchMoves=0;exType='matching';$('exTitle').textContent=`لعبة المطابقة - ${S.level.toUpperCase()}`;$('exProg').textContent=`0/${words.length}`;$$('.page').forEach(p=>p.classList.remove('active'));$('exPage').classList.add('active');renderMatching()}
