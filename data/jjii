function showSpeedQ(){if(exIdx>=exWords.length){clearInterval(speedTimer);showExResult();return}const w=exWords[exIdx],words=getLevelWords(),wrong=words.filter(x=>x.ar!==w.ar).sort(()=>Math.random()-.5).slice(0,3),opts=[w.ar,...wrong.map(x=>x.ar)].sort(()=>Math.random()-.5);$('exProg').textContent=`${exIdx+1}/${exWords.length}`;$('exContent').innerHTML=`<div class="exercise"><div style="display:flex;justify-content:space-between;margin-bottom:15px"><div style="font-size:14px;font-weight:700">⏱️ <span id="speedTimer">${speedTime}</span> ثانية</div><div style="font-size:14px;font-weight:700">🎯 ${exScore} نقطة</div></div><div class="exercise-title">ما معنى "<span class="itc">${w.it}</span>"؟</div><div class="quiz-opts">${opts.map(o=>`<div class="quiz-opt" onclick="selSpeedAns(this,'${esc(o)}','${esc(w.ar)}')"><span>${o}</span></div>`).join('')}</div></div>`}
function selSpeedAns(el,sel,cor){$$('.quiz-opt').forEach(o=>o.classList.add('disabled'));if(sel===cor){el.classList.add('correct');exScore++;addXP(3)}else el.classList.add('wrong');setTimeout(()=>{exIdx++;showSpeedQ()},500)}
function showExResult(){if(speedTimer)clearInterval(speedTimer);const pct=Math.round(exScore/exWords.length*100);$('exContent').innerHTML=`<div class="exercise" style="text-align:center"><div style="font-size:50px;margin-bottom:15px">${pct>=70?'🎉':'💪'}</div><div style="font-size:22px;font-weight:800;margin-bottom:10px">${pct>=70?'ممتاز!':'أحسنت!'}</div><div style="font-size:18px;margin-bottom:20px">${exScore}/${exWords.length} (${pct}%)</div><button class="btn btn-p" onclick="openSection('practice')" style="width:100%"><i class="fas fa-arrow-right"></i> العودة</button></div>`}
function exitEx(){if(speedTimer)clearInterval(speedTimer);openSection('practice')}

// Achievements
function checkAchievements(){const stats=getAchStats();ACHIEVE.forEach(a=>{if(!S.unlocked.includes(a.id)&&a.cond(stats))unlockAch(a)});updateAchUI()}
function getAchStats(){let words=0;Object.values(S.wordProg).forEach(p=>{if(p.status!==SRS.status.NEW)words++});return{words,quizzes:S.quizzes,perfect:S.perfect,streak:S.streak,xp:S.xp,liked:S.liked.length}}
function unlockAch(a){S.unlocked.push(a.id);S.newAch.push(a.id);S.xp+=a.xp;addNotif('achievement',`إنجاز جديد: ${a.title}`,a.desc,Date.now());saveState();showAchModal(a)}
function showAchModal(a){$('achieveIcon').textContent=a.icon;$('achieveTitle').textContent=a.title;$('achieveDesc').textContent=a.desc;$('achieveXP').textContent='+'+a.xp+' XP';$('overlay').classList.add('show');$('achieveModal').classList.add('show')}
function closeAchieve(){$('overlay').classList.remove('show');$('achieveModal').classList.remove('show')}
function updateAchUI(){$('achieveBadge').style.display=S.newAch.length>0?'flex':'none'}
function renderAchievements(){const stats=getAchStats();$('achieveGrid').innerHTML=ACHIEVE.map(a=>{const unlocked=S.unlocked.includes(a.id),isNew=S.newAch.includes(a.id),prog=getAchProg(a,stats);return`<div class="achievement ${unlocked?'unlocked':'locked'} ${isNew?'new':''}">${unlocked?'<div class="achievement-badge">✓</div>':''}<div class="achievement-xp">+${a.xp} XP</div><div class="achievement-icon">${a.icon}</div><div class="achievement-title">${a.title}</div><div class="achievement-desc">${a.desc}</div>${!unlocked?`<div class="achievement-prog"><div class="achievement-prog-fill" style="width:${prog}%"></div></div>`:''}</div>`}).join('');S.newAch=[];saveState();updateAchUI();$('unlockedAch').textContent=S.unlocked.length}
function getAchProg(a,stats){const t={first_word:1,ten_words:10,fifty_words:50,hundred_words:100,first_quiz:1,five_quizzes:5,perfect_quiz:1,streak_3:3,streak_7:7,xp_100:100,xp_500:500,liked_10:10};const v={first_word:stats.words,ten_words:stats.words,fifty_words:stats.words,hundred_words:stats.words,first_quiz:stats.quizzes,five_quizzes:stats.quizzes,perfect_quiz:stats.perfect,streak_3:stats.streak,streak_7:stats.streak,xp_100:stats.xp,xp_500:stats.xp,liked_10:stats.liked};return t[a.id]&&v[a.id]!==undefined?Math.min(v[a.id]/t[a.id]*100,100):0}

// Statistics
function renderStats(){const stats=getAchStats();$('sTotalWords').textContent=stats.words;$('sTotalXP').textContent=S.xp;$('sTotalQuiz').textContent=S.quizzes;$('sAccuracy').textContent=(S.totalQ>0?Math.round(S.correct/S.totalQ*100):0)+'%';$('sCurStreak').textContent=S.streak;$('sLongStreak').textContent=S.longStreak;$('sTotalDays').textContent=S.totalDays;$('sAvgTime').textContent='0 د';['a1','a2','b1','b2'].forEach(l=>{const p=calcLevelProg(l);const pel=$(`sProg${l.toUpperCase()}`),vel=$(`sVal${l.toUpperCase()}`);if(pel)pel.style.width=p+'%';if(vel)vel.textContent=p+'%'});renderWeekly()}
function renderWeekly(){const ch=$('weeklyChart');if(!ch)return;const days=['س','أ','إ','ث','أ','خ','ج'],max=Math.max(...S.weeklyXP,50);ch.innerHTML=S.weeklyXP.map((x,i)=>{const h=max>0?x/max*100:0;return`<div class="chart-bar" style="height:100%"><div class="chart-bar-fill" style="height:${h}%"></div><div class="chart-bar-label">${days[i]}</div></div>`}).join('')}

// Streak & XP
function checkStreak(){const today=new Date().toDateString(),yesterday=new Date(Date.now()-864e5).toDateString();if(S.lastStudy!==today)S.dailyXP=0;if(S.lastStudy&&S.lastStudy!==today&&S.lastStudy!==yesterday)S.streak=0}
function recordStudy(){const today=new Date().toDateString(),dow=new Date().getDay();if(S.lastStudy!==today){const yesterday=new Date(Date.now()-864e5).toDateString();S.streak=S.lastStudy===yesterday||!S.lastStudy?S.streak+1:1;if(S.streak>S.longStreak)S.longStreak=S.streak;if([3,7,30].includes(S.streak))addNotif('streak',`${S.streak} أيام متتالية! 🔥`,'استمر في التعلم',Date.now());S.lastStudy=today;S.totalDays++}S.weeklyXP[dow]=(S.weeklyXP[dow]||0)+1;saveState();updateUI()}
function addXP(amt){S.xp+=amt;S.dailyXP+=amt;const dow=new Date().getDay();S.weeklyXP[dow]=(S.weeklyXP[dow]||0)+amt;if(S.dailyXP>=S.goal&&S.dailyXP-amt<S.goal){S.goalDone++;addNotif('xp','أكملت هدفك اليومي! 🎯',`جمعت ${S.goal} XP`,Date.now());toast('🎯 أكملت هدفك اليومي!','success')}const newLvl=Math.floor(S.xp/100)+1;if(newLvl>S.userLvl){S.userLvl=newLvl;addNotif('level',`وصلت للمستوى ${newLvl}! 🎉`,'استمر',Date.now());toast(`🎉 وصلت للمستوى ${newLvl}!`,'success')}recordStudy();checkAchievements();saveState();updateUI()}

// Profile
function updateProfile(){$('pLevel').textContent=S.userLvl;$('pXP').textContent=S.xp;const cur=S.xp%100;$('pProgFill').style.width=cur+'%';$('pNext').textContent=100-cur;const stats=getAchStats();$('pWords').textContent=stats.words;$('pQuizzes').textContent=S.quizzes;$('pStreak').textContent=S.streak;$('pLongStreak').textContent=S.longStreak;renderLikedPreview()}
function renderLikedPreview(){$('likedCount').textContent=S.liked.length+' كلمات';const con=$('likedPreview');if(!S.liked.length){con.innerHTML='<div style="text-align:center;padding:10px;color:var(--text2);font-size:12px">لا توجد كلمات مفضلة</div>';return}con.innerHTML=S.liked.slice(0,3).map(w=>`<div style="display:inline-block;background:var(--light);padding:5px 10px;border-radius:15px;margin:3px;font-size:12px">❤️ <span class="it">${w.it}</span></div>`).join('')+(S.liked.length>3?`<div style="display:inline-block;color:var(--text2);font-size:11px;margin:3px">+${S.liked.length-3} أخرى</div>`:'')}
function confirmDelFav(i){pendingDel=i;pendingAct='delFav';const w=S.liked[i];$('confirmIcon').textContent='🗑️';$('confirmTitle').textContent='حذف الكلمة؟';$('confirmText').textContent=`هل تريد حذف "${w.it}" من المفضلة؟`;$('confirmBtn').textContent='حذف';$('overlay').classList.add('show');$('confirm').classList.add('show')}
function doConfirm(){if(pendingAct==='delFav'&&pendingDel!==null){S.liked.splice(pendingDel,1);saveState();renderFavs();renderLikedPreview();updateWodLike();toast('تم الحذف','success')}else if(pendingAct==='reset'){localStorage.removeItem(C.STATE);for(let i=localStorage.length-1;i>=0;i--){const k=localStorage.key(i);if(k?.startsWith(C.CACHE))localStorage.removeItem(k)}location.reload();return}closeConfirm()}
function closeConfirm(){$('overlay').classList.remove('show');$('confirm').classList.remove('show');pendingDel=null;pendingAct=null}

// Notifications
function addNotif(type,text,desc,ts){S.notifs.unshift({id:Date.now(),type,text,desc,time:ts,read:false});if(S.notifs.length>20)S.notifs=S.notifs.slice(0,20);saveState();updateNotifBadge()}
function toggleNotifPanel(){$('notifDropdown').classList.toggle('show');if($('notifDropdown').classList.contains('show'))renderNotifs()}
function renderNotifs(){const list=$('notifList');if(!S.notifs.length){list.innerHTML='<div class="notif-empty"><i class="fas fa-bell-slash"></i><p>لا توجد إشعارات</p></div>';return}const icons={achievement:'🏆',streak:'🔥',xp:'⭐',reminder:'⏰',level:'🎉'};list.innerHTML=S.notifs.map(n=>`<div class="notif-item ${n.read?'':'unread'}" onclick="markNotifRead(${n.id})"><div class="notif-icon ${n.type}">${icons[n.type]||'📢'}</div><div class="notif-content"><div class="notif-text">${n.text}</div><div class="notif-desc">${n.desc}</div><div class="notif-time">${timeAgo(n.time)}</div></div></div>`).join('')}
function timeAgo(ts){const s=Math.floor((Date.now()-ts)/1000);if(s<60)return'الآن';if(s<3600)return`منذ ${Math.floor(s/60)} دقيقة`;if(s<86400)return`منذ ${Math.floor(s/3600)} ساعة`;return`منذ ${Math.floor(s/86400)} يوم`}
function markNotifRead(id){const n=S.notifs.find(x=>x.id===id);if(n){n.read=true;saveState();updateNotifBadge();renderNotifs()}}
function clearNotifs(){S.notifs=[];saveState();updateNotifBadge();renderNotifs();toast('تم مسح الإشعارات','success')}
function updateNotifBadge(){const c=S.notifs.filter(n=>!n.read).length;$('notifBadge').textContent=c>9?'9+':c;$('notifBadge').style.display=c>0?'flex':'none'}

// Settings
function openSettings(){$('overlay').classList.add('show');$('settingsModal').classList.add('show');$('darkToggle').classList.toggle('active',S.dark);$('soundToggle').classList.toggle('active',S.sound);$('notifToggle').classList.toggle('active',S.notif);$('goalDisplay').textContent=S.goal+' XP';$('wordsDisplay').textContent=S.wordsPerSession+' كلمات';const rates={0.6:'بطيء',0.8:'عادي',1:'سريع'};$('rateDisplay').textContent=rates[S.rate]||'عادي';const times=['06:00','09:00','12:00','18:00','21:00'],labels=['6:00 صباحاً','9:00 صباحاً','12:00 ظهراً','6:00 مساءً','9:00 مساءً'];$('reminderDisplay').textContent=labels[times.indexOf(S.reminder)]||'9:00 صباحاً'}
function closeModal(){$('overlay').classList.remove('show');$('settingsModal').classList.remove('show')}
function toggleDark(){S.dark=!S.dark;document.body.classList.toggle('dark-mode',S.dark);$('darkToggle').classList.toggle('active',S.dark);saveState();toast(S.dark?'🌙 الوضع الليلي':'☀️ الوضع النهاري','info')}
function toggleSound(){S.sound=!S.sound;$('soundToggle').classList.toggle('active',S.sound);saveState();toast(S.sound?'🔊 الصوت مفعّل':'🔇 الصوت متوقف','info')}
function changeRate(){const r=[0.6,0.8,1],labels={0.6:'بطيء',0.8:'عادي',1:'سريع'};S.rate=r[(r.indexOf(S.rate)+1)%r.length];$('rateDisplay').textContent=labels[S.rate];saveState();speak('Ciao');toast(`سرعة النطق: ${labels[S.rate]}`,'info')}
function toggleNotif(){S.notif=!S.notif;$('notifToggle').classList.toggle('active',S.notif);saveState();toast(S.notif?'🔔 الإشعارات مفعّلة':'🔕 الإشعارات متوقفة','info')}
function setReminder(){const t=['06:00','09:00','12:00','18:00','21:00'],l=['6:00 صباحاً','9:00 صباحاً','12:00 ظهراً','6:00 مساءً','9:00 مساءً'],i=(t.indexOf(S.reminder)+1)%t.length;S.reminder=t[i];$('reminderDisplay').textContent=l[i];saveState();toast(`⏰ وقت التذكير: ${l[i]}`,'info')}
function setGoal(){const g=[30,50,100,150,200];S.goal=g[(g.indexOf(S.goal)+1)%g.length];$('goalDisplay').textContent=S.goal+' XP';$('dailyTarget').textContent=S.goal;saveState();updateUI();toast(`🎯 الهدف: ${S.goal} XP`,'success')}
function setWords(){const w=[5,10,15,20,25];S.wordsPerSession=w[(w.indexOf(S.wordsPerSession)+1)%w.length];$('wordsDisplay').textContent=S.wordsPerSession+' كلمات';saveState();toast(`📚 كلمات كل جلسة: ${S.wordsPerSession}`,'info')}
function resetProg(){$('confirmIcon').textContent='⚠️';$('confirmTitle').textContent='إعادة التقدم؟';$('confirmText').textContent='سيتم حذف جميع بياناتك!';$('confirmBtn').textContent='إعادة';pendingAct='reset';$('confirm').classList.add('show')}

// UI Updates
function updateUI(){$('streak').textContent=S.streak;$('xp').textContent=S.xp;$('userLvl').textContent=S.userLvl;$('dailyXP').textContent=S.dailyXP;$('dailyTarget').textContent=S.goal;$('goalFill').style.width=Math.min(S.dailyXP/S.goal*100,100)+'%';$('curLvl').textContent=S.level.toUpperCase();$$('.cur-lvl-text').forEach(e=>e.textContent=S.level.toUpperCase());const p=calcLevelProg(S.level);$('lvlProg').textContent=p+'%';$('lvlProgBar').style.width=p+'%';$('lvlProgBar').className=`prog-fill ${S.level}`;updateStats();updateCounts();updateAchUI();updateNotifBadge();updateLevelProgs();updateStudyStats()}
function updateStats(){const s=getAchStats();$('wordsLearned').textContent=s.words;$('phrasesLearned').textContent=0;$('grammarLearned').textContent=0;$('quizzesDone').textContent=S.quizzes}
function updateCounts(){const l=S.level;let tw=0;Object.values(DB.words[l]||{}).forEach(c=>tw+=c.words?.length||0);$('wordsCount').textContent=tw+' كلمة';let tp=0;(DB.phrases[l]||[]).forEach(p=>tp+=p.phrases?.length||0);$('phrasesCount').textContent=tp+' عبارة';$('convsCount').textContent=(DB.conversations[l]?.length||0)+' محادثة';$('grammarCount').textContent=(DB.grammar[l]?.length||0)+' درس'}

// Utilities
function speak(text,rate){if(S.sound&&'speechSynthesis'in window){speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(text);u.lang='it-IT';u.rate=rate||S.rate;speechSynthesis.speak(u)}}
function toast(msg,type='info'){const t=$('toast');$('toastMsg').textContent=msg;t.className=`toast ${type}`;const icons={success:'fa-check-circle',error:'fa-times-circle',warning:'fa-exclamation-triangle',info:'fa-info-circle'};t.querySelector('i').className=`fas ${icons[type]||icons.info}`;t.classList.add('show');setTimeout(()=>t.classList.remove('show'),2500)}

// Events
$('overlay')?.addEventListener('click',e=>{if(e.target.id==='overlay'){closeModal();closeConfirm();closeAchieve()}});
document.addEventListener('keydown',e=>{if(e.key==='Enter'){const s=$('spellInput'),l=$('listenInput');if(s&&document.activeElement===s)checkSpelling();else if(l&&document.activeElement===l)checkListenEx()}});
window.addEventListener('online',()=>{$('offline').classList.remove('show');toast('🌐 تم استعادة الاتصال','success')});
window.addEventListener('offline',()=>{$('offline').classList.add('show');toast('📴 أنت غير متصل','warning')});
window.addEventListener('beforeunload',saveState);
document.addEventListener('visibilitychange',()=>{if(document.visibilityState==='hidden')saveState()});

// Init
async function init(){loadState();if(S.dark)document.body.classList.add('dark-mode');applyLevel();initVoice();await loadLevel();$('loading').classList.add('hide');initWod();if(!S.notifs.length)addNotif('reminder','مرحباً بك في سهل إيطالي! 📚','ابدأ رحلة تعلم الإيطالية',Date.now());updateNotifBadge();checkAchievements();updateUI();renderWeekly();updateLevelProgs()}
document.readyState==='loading'?document.addEventListener('DOMContentLoaded',init):init();
</script>
</body>
</html>