// SRS System
const getWordId=(w,l,c)=>`${l}_${c}_${w.it}`;
const getWordProg=id=>S.wordProg[id]||{status:SRS.status.NEW,interval:0,nextReview:null,ease:2.5,reviews:0,lastReview:null};
function updateWordProg(id,rating){const p=getWordProg(id),now=Date.now();p.reviews++;p.lastReview=now;if(rating==='again'){p.interval=SRS.intervals.again;p.ease=Math.max(1.3,p.ease-.2);p.status=SRS.status.LEARNING}else if(rating==='hard'){p.interval=p.interval*SRS.mult.hard;p.ease=Math.max(1.3,p.ease-.15);p.status=SRS.status.LEARNING}else if(rating==='good'){p.interval=p.status===SRS.status.NEW?SRS.intervals.good:p.interval*p.ease;p.status=p.reviews>=3?SRS.status.REVIEW:SRS.status.LEARNING}else{p.interval=p.interval*SRS.mult.easy;p.ease+=.15;p.status=SRS.status.MASTERED}p.nextReview=now+p.interval*6e4;S.wordProg[id]=p;saveState();return p}
function getReviewWords(){const now=Date.now(),r=[];for(const[id,p]of Object.entries(S.wordProg))if(p.nextReview&&p.nextReview<=now&&p.status!==SRS.status.NEW)r.push({id,p});return r.sort((a,b)=>a.p.nextReview-b.p.nextReview)}
function getStudyStats(){const lvl=S.level,data=DB.words[lvl]||{};let n=0,l=0,r=0,m=0;Object.entries(data).forEach(([cid,c])=>{c.words?.forEach(w=>{const st=getWordProg(getWordId(w,lvl,cid)).status;if(st===SRS.status.NEW)n++;else if(st===SRS.status.LEARNING)l++;else if(st===SRS.status.REVIEW)r++;else m++})});return{n,l,r,m}}
function updateStudyStats(){const s=getStudyStats();$('newCount').textContent=s.n;$('learningCount').textContent=s.l;$('reviewCountS').textContent=s.r;$('masteredCount').textContent=s.m;$('studyLvl').textContent=S.level.toUpperCase();const rv=getReviewWords();const ra=$('reviewAlert');if(rv.length>0){ra.classList.add('show');$('reviewCount').textContent=rv.length}else ra.classList.remove('show')}

