function updateLevelProgs(){['a1','a2','b1','b2'].forEach(l=>{const p=calcLevelProg(l);const el=$(`lp${l.toUpperCase()}`);if(el)el.style.width=`${p}%`})}
function calcLevelProg(lvl){let t=0,m=0;const d=DB.words[lvl]||{};Object.entries(d).forEach(([cid,c])=>{c.words?.forEach(w=>{t++;const st=getWordProg(getWordId(w,lvl,cid)).status;if(st===SRS.status.MASTERED||st===SRS.status.REVIEW)m++})});return t>0?Math.round(m/t*100):0}

// Word of Day
function initWod(){const today=new Date().toDateString();if(S.wodDate!==today){genWod();S.wodDate=today;S.wodCollapsed=false;saveState()}displayWod();if(S.wodCollapsed){$('wod').classList.add('collapsed');$('wodIcon').classList.replace('fa-chevron-up','fa-chevron-down')}}
