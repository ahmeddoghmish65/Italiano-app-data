function showQuizResult(){$('quizBox').style.display='none';$('quizResult').style.display='block';const pct=Math.round(quizScore/quizQs.length*100),xpE=quizScore*5;if(pct===100)S.perfect++;let icon='💪',title='حاول مجدداً!';if(pct>=90){icon='🏆';title='ممتاز!'}else if(pct>=70){icon='🎉';title='جيد جداً!'}else if(pct>=50){icon='👍';title='جيد!'}$('quizResIcon').textContent=icon;$('quizResTitle').textContent=title;$('quizResScore').textContent=`${quizScore}/${quizQs.length} (${pct}%)`;$('quizCorrect').textContent=quizScore;$('quizWrong').textContent=quizQs.length-quizScore;$('quizXP').textContent='+'+xpE;S.quizzes++;addXP(xpE)}
