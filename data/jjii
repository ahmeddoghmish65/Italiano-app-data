function startQuiz(type){quizType=type;quizQs=genQuiz(type);if(quizQs.length<4){toast('لا توجد أسئلة كافية','warning');return}quizIdx=0;quizScore=0;$('quizBox').style.display='block';$('quizResult').style.display='none';$('quizTotal').textContent=quizQs.length;$('quizListenBtn').style.display=type==='listening'?'block':'none';$('quizVoiceBox').style.display=type==='voice'?'block':'none';$('quizOpts').style.display=type==='voice'?'none':'flex';$$('.page').forEach(p=>p.classList.remove('active'));$('quizPage').classList.add('active');displayQuizQ()}
function genQuiz(type){let qs=[],words=getLevelWords();if(words.length<4)return[];words.forEach(w=>{if(type==='reverse')qs.push({q:`ما الترجمة الإيطالية لـ "${w.ar}"؟`,correct:w.it,all:words.map(x=>x.it),audio:w.it,isIt:true});else if(type==='listening')qs.push({q:'استمع واختر الترجمة الصحيحة',correct:w.ar,all:words.map(x=>x.ar),audio:w.it});else if(type==='voice')qs.push({q:'انطق الكلمة التالية:',word:w.it,correct:w.it,trans:w.ar});else qs.push({q:`ما معنى "<span class="it">${w.it}</span>"؟`,correct:w.ar,all:words.map(x=>x.ar),audio:w.it})});qs=qs.sort(()=>Math.random()-.5).slice(0,type==='mixed'?15:10);qs.forEach(q=>{if(q.all){const wrong=q.all.filter(a=>a!==q.correct).sort(()=>Math.random()-.5).slice(0,3);q.opts=[q.correct,...wrong].sort(()=>Math.random()-.5);while(q.opts.length<4)q.opts.push('---')}});return qs}
function displayQuizQ(){const q=quizQs[quizIdx];$('quizCur').textContent=quizIdx+1;$('quizProgBar').style.width=((quizIdx+1)/quizQs.length*100)+'%';if(quizType==='voice'){$('quizQ').innerHTML=q.q;$('quizHint').innerHTML=`<span style="font-size:24px;font-weight:700;color:var(--primary)">${q.word}</span><br><small>${q.trans}</small>`;$('voiceResult').style.display='none';$('quizOpts').style.display='none';$('quizVoiceBox').style.display='block'}else{$('quizQ').innerHTML=q.q;$('quizHint').textContent=quizType==='listening'?'اضغط للاستماع':'اختر الإجابة الصحيحة';$('quizOpts').style.display='flex';$('quizVoiceBox').style.display='none';const letters=['أ','ب','ج','د'],showSpeak=quizType==='reverse'&&q.isIt;$('quizOpts').innerHTML=q.opts.map((o,i)=>`<div class="quiz-opt" onclick="selectQuizOpt(this,'${esc(o)}')"><div class="quiz-opt-letter">${letters[i]}</div><span class="quiz-opt-text ${showSpeak?'it':''}">${o}</span>${showSpeak?`<button class="quiz-opt-speak" onclick="event.stopPropagation();speak('${esc(o)}')"><i class="fas fa-volume-up"></i></button>`:''}</div>`).join('')}$('quizNextBtn').style.display='none';if(quizType==='listening'&&q.audio)setTimeout(()=>speak(q.audio),500)}
function playQuizAudio(){const q=quizQs[quizIdx];if(q?.audio)speak(q.audio)}
function selectQuizOpt(el,sel){const q=quizQs[quizIdx];$$('.quiz-opt').forEach(o=>o.classList.add('disabled'));el.classList.add('selected');S.totalQ++;if(sel===q.correct){el.classList.add('correct');quizScore++;S.correct++;toast('✓ صحيح!','success')}else{el.classList.add('wrong');$$('.quiz-opt').forEach(o=>{if(o.querySelector('.quiz-opt-text').textContent===q.correct)o.classList.add('correct')});toast('✗ خطأ!','error')}$('quizNextBtn').style.display='block';$('quizNextBtn').innerHTML=quizIdx<quizQs.length-1?'التالي <i class="fas fa-chevron-left"></i>':'النتائج <i class="fas fa-trophy"></i>'}
