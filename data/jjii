<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
    <meta name="theme-color" content="#059669">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <title>سهل إيطالي - SahlItali</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
    <style>
        :root{--primary:#059669;--primary-dark:#047857;--primary-light:#10B981;--secondary:#8B5CF6;--accent:#F59E0B;--success:#22C55E;--danger:#EF4444;--warning:#F59E0B;--info:#06B6D4;--a1:#22C55E;--a2:#3B82F6;--b1:#F59E0B;--b2:#EF4444;--dark:#1F2937;--light:#F9FAFB;--card:#FFF;--text:#1F2937;--text2:#6B7280;--border:#E5E7EB;--shadow:0 4px 6px -1px rgba(0,0,0,.1);--shadow-lg:0 10px 25px -5px rgba(0,0,0,.1);--radius:16px;--radius-sm:10px;--nav-h:70px;--safe-b:env(safe-area-inset-bottom,0px)}
        body.dark-mode{--dark:#111827;--light:#1F2937;--card:#374151;--text:#F3F4F6;--text2:#9CA3AF;--border:#4B5563;background:linear-gradient(135deg,#111827,#1F2937)}
        *{margin:0;padding:0;box-sizing:border-box;font-family:'Tajawal',sans-serif;-webkit-tap-highlight-color:transparent}
        html,body{height:100%;overflow:hidden}
        body{background:linear-gradient(135deg,#ECFDF5,#D1FAE5);color:var(--text)}
        .it{direction:ltr;unicode-bidi:bidi-override}
        .itc{direction:ltr;unicode-bidi:bidi-override;text-align:center}

        /* Loading & Offline */
        .loading{position:fixed;inset:0;background:linear-gradient(135deg,#059669,#047857);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:99999;transition:.5s}
        .loading.hide{opacity:0;visibility:hidden}
        .spinner{width:50px;height:50px;border:4px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin 1s linear infinite;margin-bottom:20px}
        @keyframes spin{to{transform:rotate(360deg)}}
        .loading-text{color:#fff;font-size:18px;font-weight:700}
        .offline{position:fixed;top:0;left:0;right:0;background:var(--warning);color:#fff;padding:8px;text-align:center;font-size:12px;font-weight:600;z-index:99999;display:none}
        .offline.show{display:block}
        .mini-loader{position:fixed;top:70px;left:50%;transform:translateX(-50%);background:var(--primary);color:#fff;padding:8px 16px;border-radius:20px;font-size:12px;z-index:9999;display:flex;align-items:center;gap:8px;box-shadow:var(--shadow);animation:fadeDown .3s}
        @keyframes fadeDown{from{opacity:0;transform:translateX(-50%) translateY(-20px)}to{opacity:1;transform:translateX(-50%) translateY(0)}}

        /* Layout */
        .app{display:flex;flex-direction:column;height:100%;overflow:hidden}
        .header{background:linear-gradient(135deg,var(--primary),var(--primary-dark));color:#fff;padding:12px 15px;padding-top:calc(12px + env(safe-area-inset-top));flex-shrink:0;z-index:100}
        .header-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
        .logo{display:flex;align-items:center;gap:10px}
        .logo-icon{width:36px;height:36px;background:rgba(255,255,255,.2);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px}
        .logo h1{font-size:18px;font-weight:800}
        .logo small{font-size:10px;opacity:.9}
        .header-actions{display:flex;gap:8px}
        .h-btn{width:36px;height:36px;border-radius:10px;border:none;background:rgba(255,255,255,.2);color:#fff;font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;position:relative;transition:.2s}
        .h-btn:active{transform:scale(.95)}
        .badge{position:absolute;top:-2px;right:-2px;background:var(--danger);color:#fff;font-size:8px;font-weight:700;width:16px;height:16px;border-radius:50%;display:flex;align-items:center;justify-content:center;border:2px solid var(--primary)}
        .stats-bar{display:flex;gap:8px}
        .stat{background:rgba(255,255,255,.2);padding:5px 10px;border-radius:15px;font-size:11px;font-weight:600;display:flex;align-items:center;gap:4px}
        .main{flex:1;overflow-y:auto;overflow-x:hidden;-webkit-overflow-scrolling:touch;padding-bottom:calc(var(--nav-h) + var(--safe-b) + 20px)}
        .page{display:none;padding:15px;min-height:100%}
        .page.active{display:block;animation:fadeIn .2s}
        @keyframes fadeIn{from{opacity:0}to{opacity:1}}

        /* Bottom Nav */
        .nav{position:fixed;bottom:0;left:0;right:0;height:calc(var(--nav-h) + var(--safe-b));background:var(--card);display:flex;justify-content:space-around;align-items:flex-start;padding-top:8px;padding-bottom:var(--safe-b);box-shadow:0 -4px 20px rgba(0,0,0,.1);z-index:9999;border-top:1px solid var(--border)}
        .nav-item{display:flex;flex-direction:column;align-items:center;padding:8px 12px;color:var(--text2);font-size:10px;font-weight:600;cursor:pointer;border:none;background:none;min-width:60px;transition:.2s;border-radius:12px;position:relative}
        .nav-item i{font-size:22px;margin-bottom:4px;transition:.2s}
        .nav-item.active{color:var(--primary)}
        .nav-item.active i{transform:scale(1.1)}
        .nav-item.active::before{content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);width:30px;height:3px;background:var(--primary);border-radius:0 0 3px 3px}
        .nav-item:active{transform:scale(.95);background:var(--light)}

        /* Cards & Common */
        .card{background:var(--card);border-radius:var(--radius);padding:15px;box-shadow:var(--shadow);margin-bottom:12px}
        .card-title{font-size:13px;font-weight:700;margin-bottom:10px;display:flex;align-items:center;gap:8px}
        .btn{padding:10px 15px;border:none;border-radius:var(--radius-sm);font-size:13px;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:5px;font-family:'Tajawal',sans-serif;transition:.1s}
        .btn:active{transform:scale(.95);opacity:.9}
        .btn-p{background:var(--primary);color:#fff}
        .btn-s{background:var(--light);color:var(--text);border:2px solid var(--border)}
        .empty{text-align:center;padding:30px;color:var(--text2)}
        .empty i{font-size:40px;margin-bottom:12px;opacity:.5}

        /* Word of Day */
        .wod{background:linear-gradient(135deg,#667eea,#764ba2);border-radius:var(--radius);color:#fff;box-shadow:var(--shadow-lg);overflow:hidden;margin-bottom:12px}
        .wod.collapsed .wod-content{display:none}
        .wod-header{display:flex;justify-content:space-between;align-items:center;padding:10px 12px}
        .wod-badge{background:rgba(255,255,255,.2);padding:4px 10px;border-radius:12px;font-size:11px;font-weight:600}
        .wod-date{font-size:9px;opacity:.8;margin-top:2px}
        .wod-actions{display:flex;gap:6px}
        .wod-btn{width:28px;height:28px;border-radius:50%;border:none;background:rgba(255,255,255,.2);color:#fff;font-size:12px;cursor:pointer;display:flex;align-items:center;justify-content:center}
        .wod-btn.liked{background:var(--danger)}
        .wod-content{padding:0 12px 12px;text-align:center}
        .wod-it{font-size:22px;font-weight:800;margin-bottom:3px}
        .wod-ph{font-size:11px;opacity:.8;margin-bottom:6px;font-style:italic}
        .wod-type{display:inline-block;background:rgba(255,255,255,.2);padding:2px 8px;border-radius:8px;font-size:9px;margin-bottom:8px}
        .wod-ar{font-size:16px;font-weight:600;padding:8px;background:rgba(255,255,255,.1);border-radius:var(--radius-sm);margin-bottom:8px}
        .wod-ex{background:rgba(0,0,0,.2);padding:8px 10px;border-radius:var(--radius-sm);text-align:center}
        .wod-ex-label{font-size:9px;opacity:.7;margin-bottom:3px}
        .wod-ex-it{font-size:12px;font-weight:600;margin-bottom:2px}
        .wod-ex-ar{font-size:11px;opacity:.9}
        .wod-collapsed{display:none;padding:0 12px 10px;align-items:center;justify-content:space-between}
        .wod.collapsed .wod-collapsed{display:flex}
        .wod-c-text{display:flex;align-items:center;gap:8px}
        .wod-c-word{font-size:14px;font-weight:700}
        .wod-c-mean{font-size:12px;opacity:.9}
        .wod-expand{background:rgba(255,255,255,.2);border:none;color:#fff;padding:5px 10px;border-radius:12px;font-size:10px;cursor:pointer;font-family:'Tajawal',sans-serif}

        /* Daily Goal */
        .goal{background:linear-gradient(135deg,var(--accent),#FB923C);color:#fff;border-radius:var(--radius);padding:12px 15px;margin-bottom:12px}
        .goal-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px}
        .goal-title{font-size:13px;font-weight:700}
        .goal-xp{font-size:12px}
        .goal-bar{height:6px;background:rgba(255,255,255,.3);border-radius:3px;overflow:hidden}
        .goal-fill{height:100%;background:#fff;border-radius:3px;transition:width .3s}

        /* Level Selector */
        .levels{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
        .level{padding:12px 8px;border:2px solid var(--border);border-radius:var(--radius-sm);background:var(--light);text-align:center;cursor:pointer;font-weight:700;font-size:14px;transition:.3s;position:relative;overflow:hidden}
        .level::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;opacity:0;transition:.3s}
        .level.a1{border-color:var(--a1);color:var(--a1)}.level.a1::before{background:var(--a1)}
        .level.a2{border-color:var(--a2);color:var(--a2)}.level.a2::before{background:var(--a2)}
        .level.b1{border-color:var(--b1);color:var(--b1)}.level.b1::before{background:var(--b1)}
        .level.b2{border-color:var(--b2);color:var(--b2)}.level.b2::before{background:var(--b2)}
        .level.active.a1{background:var(--a1);color:#fff}
        .level.active.a2{background:var(--a2);color:#fff}
        .level.active.b1{background:var(--b1);color:#fff}
        .level.active.b2{background:var(--b2);color:#fff}
        .level:not(.active):hover{transform:translateY(-2px);box-shadow:var(--shadow)}
        .level:not(.active)::before{opacity:1}
        .level small{display:block;font-size:9px;margin-top:2px;opacity:.8}
        .level-prog{width:100%;height:4px;background:rgba(255,255,255,.3);border-radius:2px;margin-top:6px;overflow:hidden}
        .level.active .level-prog{background:rgba(255,255,255,.3)}
        .level:not(.active) .level-prog{background:var(--border)}
        .level-prog-fill{height:100%;border-radius:2px;transition:width .5s}
        .level.active .level-prog-fill{background:#fff}
        .level.a1:not(.active) .level-prog-fill{background:var(--a1)}
        .level.a2:not(.active) .level-prog-fill{background:var(--a2)}
        .level.b1:not(.active) .level-prog-fill{background:var(--b1)}
        .level.b2:not(.active) .level-prog-fill{background:var(--b2)}

        /* Study Stats */
        .study-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
        .study-stat{text-align:center;padding:10px;border-radius:var(--radius-sm)}
        .study-stat.new{background:rgba(59,130,246,.1)}
        .study-stat.learning{background:rgba(245,158,11,.1)}
        .study-stat.review{background:rgba(139,92,246,.1)}
        .study-stat.mastered{background:rgba(34,197,94,.1)}
        .study-stat-val{font-size:18px;font-weight:800}
        .study-stat.new .study-stat-val{color:var(--info)}
        .study-stat.learning .study-stat-val{color:var(--warning)}
        .study-stat.review .study-stat-val{color:var(--secondary)}
        .study-stat.mastered .study-stat-val{color:var(--success)}
        .study-stat-label{font-size:9px;color:var(--text2)}

        /* Review Alert */
        .review-alert{background:linear-gradient(135deg,#FEF3C7,#FDE68A);border-radius:var(--radius);padding:15px;margin-bottom:12px;display:none}
        .review-alert.show{display:block}
        .review-header{display:flex;justify-content:space-between;align-items:center}
        .review-title{font-size:14px;font-weight:700;color:#92400E;display:flex;align-items:center;gap:8px}
        .review-count{background:#92400E;color:#fff;padding:2px 8px;border-radius:10px;font-size:11px;font-weight:700}
        .review-btn{background:#92400E;color:#fff;border:none;padding:8px 15px;border-radius:var(--radius-sm);font-size:12px;font-weight:600;cursor:pointer;font-family:'Tajawal',sans-serif}

        /* Progress Overview */
        .prog-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
        .prog-title{font-size:13px;font-weight:700}
        .prog-pct{font-size:16px;font-weight:800;color:var(--primary)}
        .prog-bar{height:8px;background:var(--border);border-radius:4px;overflow:hidden;margin-bottom:12px}
        .prog-fill{height:100%;border-radius:4px;transition:width .5s}
        .prog-fill.a1{background:linear-gradient(to right,var(--a1),#4ADE80)}
        .prog-fill.a2{background:linear-gradient(to right,var(--a2),#60A5FA)}
        .prog-fill.b1{background:linear-gradient(to right,var(--b1),#FBBF24)}
        .prog-fill.b2{background:linear-gradient(to right,var(--b2),#F87171)}
        .prog-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
        .prog-stat{text-align:center;padding:8px;background:var(--light);border-radius:var(--radius-sm)}
        .prog-stat-val{font-size:16px;font-weight:800;color:var(--primary)}
        .prog-stat-label{font-size:9px;color:var(--text2)}

        /* Section Grid */
        .sections{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
        .section{background:var(--card);border-radius:var(--radius);padding:15px;text-align:center;cursor:pointer;box-shadow:var(--shadow);position:relative;overflow:hidden;transition:transform .2s}
        .section::before{content:'';position:absolute;top:0;left:0;right:0;height:3px}
        .section.words::before{background:var(--a1)}
        .section.phrases::before{background:var(--a2)}
        .section.conversations::before{background:var(--b1)}
        .section.grammar::before{background:var(--b2)}
        .section.quiz::before{background:var(--secondary)}
        .section.practice::before{background:var(--accent)}
        .section:active{transform:scale(.97)}
        .section-icon{width:45px;height:45px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:20px;margin:0 auto 10px;color:#fff}
        .section.words .section-icon{background:linear-gradient(135deg,var(--a1),#4ADE80)}
        .section.phrases .section-icon{background:linear-gradient(135deg,var(--a2),#60A5FA)}
        .section.conversations .section-icon{background:linear-gradient(135deg,var(--b1),#FBBF24)}
        .section.grammar .section-icon{background:linear-gradient(135deg,var(--b2),#F87171)}
        .section.quiz .section-icon{background:linear-gradient(135deg,var(--secondary),#A855F7)}
        .section.practice .section-icon{background:linear-gradient(135deg,var(--accent),#FB923C)}
        .section-title{font-size:13px;font-weight:700;margin-bottom:3px}
        .section-count{font-size:10px;color:var(--text2)}
        .section-badge{position:absolute;top:8px;left:8px;background:var(--danger);color:#fff;font-size:9px;font-weight:700;padding:2px 6px;border-radius:8px}

        /* Page Header */
        .page-header{display:flex;align-items:center;gap:12px;margin-bottom:15px;padding-bottom:12px;border-bottom:1px solid var(--border)}
        .page-back{width:38px;height:38px;border-radius:10px;border:none;background:var(--light);color:var(--text);font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center}
        .page-title{font-size:18px;font-weight:800}
        .page-sub{font-size:11px;color:var(--text2)}

        /* Category List */
        .cat-list{display:flex;flex-direction:column;gap:10px}
        .cat-item{background:var(--card);border-radius:var(--radius-sm);padding:12px;display:flex;align-items:center;gap:12px;cursor:pointer;box-shadow:var(--shadow);transition:transform .2s}
        .cat-item:active{transform:scale(.98)}
        .cat-icon{width:45px;height:45px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;flex-shrink:0}
        .cat-info{flex:1;min-width:0}
        .cat-name{font-size:14px;font-weight:700;margin-bottom:2px}
        .cat-meta{font-size:11px;color:var(--text2)}
        .cat-prog{font-size:14px;font-weight:800;color:var(--primary)}
        .cat-arrow{color:var(--text2);font-size:12px}

        /* Search Box */
        .search{background:var(--card);border-radius:var(--radius-sm);padding:10px 12px;display:flex;align-items:center;gap:10px;margin-bottom:12px;box-shadow:var(--shadow)}
        .search input{flex:1;border:none;background:none;font-size:14px;color:var(--text);outline:none;font-family:'Tajawal',sans-serif}
        .search input::placeholder{color:var(--text2)}

        /* Dictionary */
        .dict-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:15px}
        .dict-stat{text-align:center;padding:10px;background:var(--light);border-radius:var(--radius-sm);cursor:pointer;transition:.2s;border:2px solid transparent}
        .dict-stat:hover{transform:translateY(-2px)}
        .dict-stat.active{border-color:var(--primary);background:rgba(5,150,105,.1)}
        .dict-stat-val{font-size:18px;font-weight:800}
        .dict-stat-label{font-size:9px;color:var(--text2)}
        .dict-stat.a1 .dict-stat-val{color:var(--a1)}
        .dict-stat.a2 .dict-stat-val{color:var(--a2)}
        .dict-stat.b1 .dict-stat-val{color:var(--b1)}
        .dict-stat.b2 .dict-stat-val{color:var(--b2)}
        .dict-cat{background:var(--card);border-radius:var(--radius);margin-bottom:12px;box-shadow:var(--shadow);overflow:hidden}
        .dict-cat-header{display:flex;justify-content:space-between;align-items:center;padding:12px 15px;cursor:pointer;background:var(--light);transition:.2s}
        .dict-cat-header:active{background:var(--border)}
        .dict-cat-info{display:flex;align-items:center;gap:12px}
        .dict-cat-icon{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;color:#fff}
        .dict-cat-text h3{font-size:14px;font-weight:700;margin-bottom:2px}
        .dict-cat-text span{font-size:11px;color:var(--text2)}
        .dict-cat-toggle{font-size:14px;color:var(--text2);transition:transform .3s}
        .dict-cat.open .dict-cat-toggle{transform:rotate(180deg)}
        .dict-cat-content{max-height:0;overflow:hidden;transition:max-height .3s}
        .dict-cat.open .dict-cat-content{max-height:2000px;padding:0 15px 15px}
        .word-item{background:var(--light);border-radius:var(--radius-sm);padding:12px;display:flex;align-items:center;gap:12px;margin-bottom:8px;transition:transform .2s}
        .word-item:last-child{margin-bottom:0}
        .word-item:active{transform:scale(.98)}
        .word-level{width:35px;height:35px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;color:#fff;flex-shrink:0}
        .word-level.a1{background:var(--a1)}
        .word-level.a2{background:var(--a2)}
        .word-level.b1{background:var(--b1)}
        .word-level.b2{background:var(--b2)}
        .word-info{flex:1;min-width:0}
        .word-it{font-size:15px;font-weight:700;color:var(--text)}
        .word-ar{font-size:12px;color:var(--text2)}
        .word-status{display:flex;align-items:center;gap:4px;margin-top:4px}
        .status-badge{font-size:8px;padding:2px 6px;border-radius:4px;font-weight:600}
        .status-badge.new{background:rgba(59,130,246,.1);color:var(--info)}
        .status-badge.learning{background:rgba(245,158,11,.1);color:var(--warning)}
        .status-badge.review{background:rgba(139,92,246,.1);color:var(--secondary)}
        .status-badge.mastered{background:rgba(34,197,94,.1);color:var(--success)}
        .word-actions{display:flex;gap:5px}
        .word-btn{width:32px;height:32px;border-radius:8px;border:none;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:14px;transition:transform .2s}
        .word-btn:active{transform:scale(.9)}
        .word-btn.speak{background:var(--light);color:var(--primary)}
        .word-btn.like{background:rgba(239,68,68,.1);color:var(--text2)}
        .word-btn.like.liked{background:var(--danger);color:#fff}

        /* Word Card */
        .word-card-wrap{perspective:1500px;height:260px;margin-bottom:15px}
        .word-card{position:relative;width:100%;height:100%;transition:transform .6s;transform-style:preserve-3d;cursor:pointer;will-change:transform}
        .word-card.flipped{transform:rotateY(180deg)}
        .word-card-face{position:absolute;width:100%;height:100%;backface-visibility:hidden;-webkit-backface-visibility:hidden;border-radius:var(--radius);padding:20px;display:flex;flex-direction:column;align-items:center;justify-content:center;box-shadow:var(--shadow-lg)}
        .word-card-front{background:var(--card);border:2px solid var(--border)}
        .word-card-back{background:linear-gradient(135deg,var(--primary),var(--primary-dark));color:#fff;transform:rotateY(180deg)}
        .wc-level{position:absolute;top:12px;left:12px;padding:4px 10px;border-radius:12px;font-size:10px;font-weight:700;color:#fff}
        .wc-level.a1{background:var(--a1)}.wc-level.a2{background:var(--a2)}.wc-level.b1{background:var(--b1)}.wc-level.b2{background:var(--b2)}
        .wc-type{position:absolute;top:12px;right:12px;padding:4px 10px;border-radius:12px;font-size:10px;font-weight:600;background:rgba(0,0,0,.05)}
        .wc-mastery{position:absolute;bottom:12px;left:12px;padding:4px 10px;border-radius:12px;font-size:9px;font-weight:600;display:flex;align-items:center;gap:4px}
        .wc-mastery.new{background:rgba(59,130,246,.1);color:var(--info)}
        .wc-mastery.learning{background:rgba(245,158,11,.1);color:var(--warning)}
        .wc-mastery.review{background:rgba(139,92,246,.1);color:var(--secondary)}
        .wc-mastery.mastered{background:rgba(34,197,94,.1);color:var(--success)}
        .wc-main{font-size:28px;font-weight:800;margin-bottom:8px;text-align:center}
        .wc-phonetic{font-size:13px;color:var(--text2);font-style:italic}
        .wc-trans{font-size:24px;font-weight:700;text-align:center;margin-bottom:12px}
        .wc-example{font-size:13px;text-align:center;padding:10px;background:rgba(255,255,255,.1);border-radius:var(--radius-sm);line-height:1.5;width:100%}
        .wc-hint{position:absolute;bottom:12px;font-size:11px;opacity:.6}

        /* Controls */
        .controls{display:flex;gap:8px;margin-bottom:12px}
        .rating-section{background:var(--card);border-radius:var(--radius);padding:15px;box-shadow:var(--shadow);margin-bottom:15px}
        .rating-title{font-size:12px;font-weight:600;color:var(--text2);margin-bottom:10px;text-align:center}
        .ratings{display:grid;grid-template-columns:repeat(4,1fr);gap:6px}
        .rating{padding:12px 5px;border:none;border-radius:var(--radius-sm);font-size:11px;font-weight:600;cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:4px;font-family:'Tajawal',sans-serif;transition:.2s}
        .rating i{font-size:16px}
        .rating small{font-size:9px;opacity:.7}
        .rating.again{background:rgba(239,68,68,.1);color:var(--danger)}
        .rating.hard{background:rgba(245,158,11,.1);color:var(--warning)}
        .rating.good{background:rgba(59,130,246,.1);color:var(--info)}
        .rating.easy{background:rgba(34,197,94,.1);color:var(--success)}
        .rating:active{transform:scale(.95)}
        .rating:hover{box-shadow:var(--shadow)}

        /* Quiz */
        .quiz-prog{display:flex;align-items:center;margin-bottom:15px;font-weight:700;font-size:13px}
        .quiz-prog-bar{flex:1;height:6px;background:var(--border);border-radius:3px;margin:0 10px;overflow:hidden}
        .quiz-prog-fill{height:100%;background:var(--primary);border-radius:3px}
        .quiz-q{text-align:center;margin-bottom:20px}
        .quiz-q-text{font-size:20px;font-weight:700;margin-bottom:8px}
        .quiz-q-hint{font-size:12px;color:var(--text2)}
        .quiz-opts{display:flex;flex-direction:column;gap:8px;margin-bottom:15px}
        .quiz-opt{padding:12px;border:2px solid var(--border);border-radius:var(--radius-sm);font-size:14px;font-weight:600;cursor:pointer;display:flex;align-items:center;gap:10px;transition:.2s}
        .quiz-opt.selected{border-color:var(--primary);background:rgba(5,150,105,.1)}
        .quiz-opt.correct{border-color:var(--success);background:rgba(34,197,94,.1)}
        .quiz-opt.wrong{border-color:var(--danger);background:rgba(239,68,68,.1)}
        .quiz-opt.disabled{pointer-events:none}
        .quiz-opt-letter{width:28px;height:28px;border-radius:50%;background:var(--light);display:flex;align-items:center;justify-content:center;font-size:13px}
        .quiz-opt.selected .quiz-opt-letter{background:var(--primary);color:#fff}
        .quiz-opt.correct .quiz-opt-letter{background:var(--success);color:#fff}
        .quiz-opt.wrong .quiz-opt-letter{background:var(--danger);color:#fff}
        .quiz-opt-text{flex:1}
        .quiz-opt-speak{width:30px;height:30px;border-radius:50%;border:none;background:var(--primary);color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:12px;transition:transform .2s}
        .quiz-opt-speak:active{transform:scale(.9)}
        .quiz-result{text-align:center;padding:20px}
        .quiz-result-icon{font-size:50px;margin-bottom:15px}
        .quiz-result-title{font-size:22px;font-weight:800;margin-bottom:8px}
        .quiz-result-score{font-size:16px;color:var(--text2);margin-bottom:15px}
        .quiz-result-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:15px}
        .quiz-result-stat{background:var(--light);padding:12px;border-radius:var(--radius-sm)}
        .quiz-result-stat-val{font-size:20px;font-weight:800}
        .quiz-result-stat-label{font-size:11px;color:var(--text2)}

        /* Voice */
        .voice-btn{width:60px;height:60px;border-radius:50%;border:none;background:linear-gradient(135deg,var(--secondary),#A855F7);color:#fff;font-size:24px;cursor:pointer;display:flex;align-items:center;justify-content:center;margin:15px auto;box-shadow:var(--shadow-lg);transition:.3s}
        .voice-btn:active{transform:scale(.95)}
        .voice-btn.listening{animation:pulse 1s infinite;background:linear-gradient(135deg,var(--danger),#F87171)}
        @keyframes pulse{0%,100%{transform:scale(1);box-shadow:0 0 0 0 rgba(139,92,246,.7)}50%{transform:scale(1.05);box-shadow:0 0 0 15px rgba(139,92,246,0)}}
        .voice-result{text-align:center;padding:10px;background:var(--light);border-radius:var(--radius-sm);margin-top:10px;font-size:14px;font-weight:600}
        .listen-btn{width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--primary-dark));border:none;color:#fff;font-size:30px;cursor:pointer;margin-bottom:20px;box-shadow:var(--shadow-lg)}
        .listen-btn:active{transform:scale(.95)}

        /* Profile */
        .profile-header{background:linear-gradient(135deg,var(--primary),var(--primary-dark));color:#fff;border-radius:var(--radius);padding:20px;text-align:center;margin-bottom:15px}
        .profile-avatar{width:70px;height:70px;background:rgba(255,255,255,.2);border-radius:50%;margin:0 auto 12px;display:flex;align-items:center;justify-content:center;font-size:32px}
        .profile-level{font-size:22px;font-weight:800}
        .profile-xp{font-size:14px;opacity:.9;margin-bottom:12px}
        .profile-prog{height:5px;background:rgba(255,255,255,.3);border-radius:3px;overflow:hidden;margin-bottom:5px}
        .profile-prog-fill{height:100%;background:#fff;border-radius:3px}
        .profile-next{font-size:10px;opacity:.8}

        /* Favorites */
        .fav-header{background:linear-gradient(135deg,#ec4899,#f43f5e);color:#fff;border-radius:var(--radius);padding:20px;text-align:center;margin-bottom:15px}
        .fav-icon{font-size:40px;margin-bottom:10px}
        .fav-count{font-size:24px;font-weight:800}
        .fav-label{font-size:12px;opacity:.9}
        .fav-actions{display:flex;gap:10px;margin-top:15px}
        .fav-action{flex:1;padding:10px;border:none;border-radius:var(--radius-sm);background:rgba(255,255,255,.2);color:#fff;font-size:12px;font-weight:600;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:5px;font-family:'Tajawal',sans-serif}
        .fav-empty{text-align:center;padding:40px 20px;color:var(--text2)}
        .fav-empty i{font-size:50px;margin-bottom:15px;opacity:.3}
        .fav-item{background:var(--card);border-radius:var(--radius-sm);padding:12px;display:flex;align-items:center;gap:10px;margin-bottom:8px;box-shadow:var(--shadow)}
        .fav-item-icon{width:40px;height:40px;background:linear-gradient(135deg,#ec4899,#f43f5e);border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:18px;flex-shrink:0}
        .fav-item-info{flex:1}
        .fav-item-it{font-size:14px;font-weight:700;color:var(--text)}
        .fav-item-ar{font-size:12px;color:var(--text2)}
        .fav-item-level{font-size:9px;padding:2px 6px;border-radius:4px;color:#fff;margin-top:3px;display:inline-block}
        .fav-item-level.a1{background:var(--a1)}.fav-item-level.a2{background:var(--a2)}.fav-item-level.b1{background:var(--b1)}.fav-item-level.b2{background:var(--b2)}
        .fav-item-actions{display:flex;gap:5px}
        .fav-item-btn{width:32px;height:32px;border-radius:8px;border:none;display:flex;align-items:center;justify-content:center;cursor:pointer;font-size:14px}
        .fav-item-btn.speak{background:var(--light);color:var(--primary)}
        .fav-item-btn.delete{background:rgba(239,68,68,.1);color:var(--danger)}
        .fav-item-btn:active{transform:scale(.95)}

        /* Phrase & Conversation */
        .phrase{background:var(--card);border-radius:var(--radius);padding:15px;margin-bottom:12px;box-shadow:var(--shadow)}
        .phrase-header{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}
        .phrase-it{font-size:18px;font-weight:700;color:var(--primary);margin-bottom:5px}
        .phrase-ar{font-size:16px;color:var(--text);margin-bottom:8px}
        .phrase-ph{font-size:12px;color:var(--text2);font-style:italic}
        .phrase-speak{width:40px;height:40px;border-radius:50%;border:none;background:var(--primary);color:#fff;font-size:16px;cursor:pointer;flex-shrink:0}
        .conv-wrap{padding:10px}
        .conv-bubble{padding:12px 15px;border-radius:15px;margin-bottom:10px;max-width:85%;position:relative}
        .conv-bubble.a{background:var(--primary);color:#fff;margin-left:auto;border-bottom-right-radius:5px}
        .conv-bubble.b{background:var(--card);border:1px solid var(--border);margin-right:auto;border-bottom-left-radius:5px}
        .conv-speaker{font-size:10px;font-weight:700;margin-bottom:5px;opacity:.8}
        .conv-it{font-size:14px;font-weight:600;margin-bottom:3px}
        .conv-ar{font-size:12px;opacity:.9}
        .conv-speak{position:absolute;top:8px;left:8px;width:28px;height:28px;border-radius:50%;border:none;background:rgba(255,255,255,.2);color:inherit;font-size:12px;cursor:pointer;display:flex;align-items:center;justify-content:center}
        .conv-bubble.b .conv-speak{background:var(--light);color:var(--primary)}
        .conv-controls{padding:15px;display:flex;flex-direction:column;gap:10px}

        /* Grammar */
        .grammar-section{background:var(--card);border-radius:var(--radius);padding:15px;margin-bottom:15px;box-shadow:var(--shadow)}
        .grammar-title{font-size:16px;font-weight:700;color:var(--primary);margin-bottom:12px;display:flex;align-items:center;gap:8px}
        .grammar-table{width:100%;border-collapse:collapse}
        .grammar-table th,.grammar-table td{padding:10px;text-align:center;border:1px solid var(--border)}
        .grammar-table th{background:var(--primary);color:#fff;font-size:12px}
        .grammar-table td{font-size:13px;background:var(--card)}
        .grammar-ex{background:var(--light);padding:12px;border-radius:var(--radius-sm);margin-top:10px}
        .grammar-ex-it{font-size:14px;font-weight:600;color:var(--primary);display:flex;align-items:center;gap:10px}
        .grammar-ex-ar{font-size:12px;color:var(--text2);margin-top:5px}

        /* Exercise */
        .exercise{background:var(--card);border-radius:var(--radius);padding:20px;margin-bottom:15px;box-shadow:var(--shadow)}
        .exercise-title{font-size:16px;font-weight:700;margin-bottom:15px;text-align:center}
        .exercise-input{width:100%;padding:12px 15px;border:2px solid var(--border);border-radius:var(--radius-sm);font-size:16px;font-family:'Tajawal',sans-serif;text-align:center;outline:none;margin-bottom:15px;background:var(--card);color:var(--text);direction:ltr}
        .exercise-input:focus{border-color:var(--primary)}
        .exercise-input.correct{border-color:var(--success);background:rgba(34,197,94,.1)}
        .exercise-input.wrong{border-color:var(--danger);background:rgba(239,68,68,.1)}
        .exercise-hint{text-align:center;color:var(--text2);font-size:12px;margin-bottom:10px}
        .letters{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:15px;direction:ltr}
        .letter{width:40px;height:40px;background:var(--light);border:2px solid var(--border);border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:18px;font-weight:700;cursor:pointer;transition:.2s}
        .letter:active{transform:scale(.95)}
        .letter.selected{background:var(--primary);border-color:var(--primary);color:#fff}
        .letter.disabled{opacity:.3;pointer-events:none}
        .answer{display:flex;flex-wrap:wrap;gap:8px;justify-content:center;margin-bottom:15px;min-height:50px;padding:10px;background:var(--light);border-radius:var(--radius-sm);direction:ltr}

        /* Matching */
        .matching{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding:10px}
        .match-card{aspect-ratio:1;background:var(--light);border:2px solid var(--border);border-radius:var(--radius-sm);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:600;cursor:pointer;transition:.3s;padding:8px;text-align:center;user-select:none}
        .match-card.flipped{background:var(--primary);color:#fff;border-color:var(--primary);transform:scale(1.05)}
        .match-card.matched{background:var(--success);border-color:var(--success);color:#fff;pointer-events:none}
        .match-card.wrong{animation:shake .4s;background:rgba(239,68,68,.2);border-color:var(--danger)}
        @keyframes shake{0%,100%{transform:translateX(0)}20%{transform:translateX(-8px)}40%{transform:translateX(8px)}60%{transform:translateX(-8px)}80%{transform:translateX(8px)}}
        .match-stats{display:flex;justify-content:center;gap:20px;padding:10px;background:var(--light);border-radius:var(--radius-sm);margin-bottom:15px}
        .match-stat{text-align:center}
        .match-stat-val{font-size:20px;font-weight:800;color:var(--primary)}
        .match-stat-label{font-size:10px;color:var(--text2)}

        /* Achievements */
        .achievements{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
        .achievement{background:var(--card);border-radius:var(--radius);padding:15px;text-align:center;box-shadow:var(--shadow);position:relative;transition:transform .2s}
        .achievement.locked{opacity:.5}
        .achievement.unlocked{border:2px solid var(--accent)}
        .achievement-icon{width:50px;height:50px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:24px;margin:0 auto 10px;background:var(--light)}
        .achievement.unlocked .achievement-icon{background:linear-gradient(135deg,var(--accent),#FB923C)}
        .achievement-title{font-size:12px;font-weight:700;margin-bottom:4px}
        .achievement-desc{font-size:10px;color:var(--text2);margin-bottom:8px}
        .achievement-prog{height:4px;background:var(--border);border-radius:2px;overflow:hidden}
        .achievement-prog-fill{height:100%;background:var(--accent);border-radius:2px;transition:width .3s}
        .achievement-badge{position:absolute;top:8px;right:8px;font-size:14px}
        .achievement-xp{position:absolute;top:8px;left:8px;background:var(--accent);color:#fff;font-size:9px;font-weight:700;padding:2px 6px;border-radius:8px}

        /* Stats */
        .stats-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
        .stat-box{background:var(--light);border-radius:var(--radius-sm);padding:12px;text-align:center}
        .stat-box-icon{font-size:20px;margin-bottom:5px}
        .stat-box-val{font-size:20px;font-weight:800;color:var(--primary)}
        .stat-box-label{font-size:10px;color:var(--text2)}
        .weekly{display:flex;justify-content:space-between;align-items:flex-end;height:100px;padding:10px 0;gap:8px}
        .chart-bar{flex:1;background:var(--border);border-radius:4px 4px 0 0;position:relative;min-height:10px;transition:.3s}
        .chart-bar-fill{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(to top,var(--primary),var(--primary-light));border-radius:4px 4px 0 0;transition:.3s}
        .chart-bar-label{position:absolute;bottom:-20px;left:50%;transform:translateX(-50%);font-size:9px;color:var(--text2)}
        .level-prog-card{display:flex;gap:10px;margin-bottom:10px}
        .level-prog-item{flex:1;background:var(--light);border-radius:var(--radius-sm);padding:10px;text-align:center}
        .level-prog-label{font-size:12px;font-weight:700;margin-bottom:5px}
        .level-prog-bar{height:6px;background:var(--border);border-radius:3px;overflow:hidden;margin-bottom:5px}
        .level-prog-val{font-size:10px;color:var(--text2)}

        /* Toast */
        .toast{position:fixed;bottom:calc(var(--nav-h) + var(--safe-b) + 20px);left:50%;transform:translateX(-50%) translateY(100px);background:var(--dark);color:#fff;padding:10px 20px;border-radius:25px;z-index:10000;opacity:0;transition:.3s;font-size:13px;font-weight:600;display:flex;align-items:center;gap:8px;pointer-events:none}
        .toast.show{transform:translateX(-50%) translateY(0);opacity:1}
        .toast.success{background:var(--success)}
        .toast.error{background:var(--danger)}
        .toast.warning{background:var(--warning)}
        .toast.info{background:var(--info)}

        /* Modal */
        .modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:10001;opacity:0;visibility:hidden;transition:.3s}
        .modal-overlay.show{opacity:1;visibility:visible}
        .modal{position:fixed;bottom:0;left:0;right:0;background:var(--card);border-radius:var(--radius) var(--radius) 0 0;padding:15px;padding-bottom:calc(15px + var(--safe-b));z-index:10002;transform:translateY(100%);transition:transform .3s;max-height:85vh;overflow-y:auto}
        .modal.show{transform:translateY(0)}
        .modal-handle{width:40px;height:4px;background:var(--border);border-radius:2px;margin:0 auto 12px}
        .modal-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px}
        .modal-title{font-size:16px;font-weight:800}
        .modal-close{width:32px;height:32px;border-radius:50%;border:none;background:var(--light);font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center}

        /* Settings */
        .settings-section{margin-bottom:20px}
        .settings-title{font-size:11px;font-weight:700;color:var(--text2);text-transform:uppercase;margin-bottom:8px;padding-right:5px}
        .settings-card{background:var(--light);border-radius:var(--radius-sm);overflow:hidden}
        .settings-item{display:flex;justify-content:space-between;align-items:center;padding:14px 12px;border-bottom:1px solid var(--border);cursor:pointer;transition:.2s}
        .settings-item:last-child{border-bottom:none}
        .settings-item:active{background:var(--border)}
        .settings-item-info{display:flex;align-items:center;gap:12px}
        .settings-item-icon{width:38px;height:38px;border-radius:10px;background:var(--card);display:flex;align-items:center;justify-content:center;font-size:16px;color:var(--primary)}
        .settings-item-icon.danger{color:var(--danger)}
        .settings-item-text h4{font-size:14px;font-weight:600;margin-bottom:2px;color:var(--text)}
        .settings-item-text p{font-size:11px;color:var(--text2)}
        .settings-item-val{font-size:12px;color:var(--text2);display:flex;align-items:center;gap:5px}
        .toggle{width:48px;height:26px;background:var(--border);border-radius:13px;position:relative;cursor:pointer;transition:.3s}
        .toggle.active{background:var(--primary)}
        .toggle::after{content:'';position:absolute;top:3px;left:3px;width:20px;height:20px;background:#fff;border-radius:50%;transition:.3s;box-shadow:0 2px 4px rgba(0,0,0,.2)}
        .toggle.active::after{left:25px}
        .app-info{text-align:center;padding:20px;color:var(--text2)}
        .app-info-logo{font-size:40px;margin-bottom:10px}
        .app-info-name{font-size:16px;font-weight:700;color:var(--text);margin-bottom:4px}
        .app-info-ver{font-size:11px}
        .social{display:flex;justify-content:center;gap:15px;padding:15px;margin-top:10px}
        .social a{width:45px;height:45px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:20px;color:#fff;text-decoration:none;transition:transform .2s}
        .social a:active{transform:scale(.95)}
        .social .fb{background:linear-gradient(135deg,#1877F2,#0D65D9)}
        .social .ig{background:linear-gradient(135deg,#E4405F,#C13584,#833AB4)}
        .social .tt{background:linear-gradient(135deg,#000,#25F4EE)}

        /* Confirm */
        .confirm{position:fixed;top:50%;left:50%;transform:translate(-50%,-50%) scale(.9);background:var(--card);border-radius:var(--radius);padding:20px;z-index:10003;width:85%;max-width:320px;opacity:0;visibility:hidden;transition:.3s;text-align:center}
        .confirm.show{transform:translate(-50%,-50%) scale(1);opacity:1;visibility:visible}
        .confirm-icon{font-size:40px;margin-bottom:12px}
        .confirm-title{font-size:16px;font-weight:700;margin-bottom:8px}
        .confirm-text{font-size:13px;color:var(--text2);margin-bottom:15px}
        .confirm-btns{display:flex;gap:10px}
        .confirm-btn{flex:1;padding:10px;border:none;border-radius:var(--radius-sm);font-size:13px;font-weight:600;cursor:pointer;font-family:'Tajawal',sans-serif}
        .confirm-btn.cancel{background:var(--light);color:var(--text)}
        .confirm-btn.ok{background:var(--danger);color:#fff}

        /* Notifications */
        .notif-dropdown{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:10001;opacity:0;visibility:hidden;transition:.3s}
        .notif-dropdown.show{opacity:1;visibility:visible}
        .notif-panel{position:absolute;top:calc(60px + env(safe-area-inset-top));right:15px;left:15px;max-height:70vh;background:var(--card);border-radius:var(--radius);box-shadow:var(--shadow-lg);overflow:hidden;transform:translateY(-20px);opacity:0;transition:.3s}
        .notif-dropdown.show .notif-panel{transform:translateY(0);opacity:1}
        .notif-header{display:flex;justify-content:space-between;align-items:center;padding:15px;border-bottom:1px solid var(--border);background:var(--light)}
