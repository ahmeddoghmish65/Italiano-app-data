        // Load state from localStorage
        function loadState() {
            const saved = localStorage.getItem('italiano_app_state');
            if (saved) {
                const parsed = JSON.parse(saved);
                state = { ...state, ...parsed };
            }
            
            // Initialize lesson progress
            initializeLessonProgress();
            
            // Check streak
            checkStreak();
        }

        // Save state to localStorage
        function saveState() {
            localStorage.setItem('italiano_app_state', JSON.stringify(state));
        }

        // Initialize lesson progress
        function initializeLessonProgress() {
            APP_DATA.levels.forEach((level, levelIndex) => {
                level.lessons.forEach((lesson, lessonIndex) => {
                    if (!state.lessonProgress[lesson.id]) {
                        if (levelIndex === 0 && lessonIndex === 0) {
                            state.lessonProgress[lesson.id] = 'available';
                        } else {
                            state.lessonProgress[lesson.id] = 'locked';
                        }
                    }
                });
            });
            saveState();
        }

        // Check and update streak
        function checkStreak() {
            const today = new Date().toDateString();
            const lastStudy = state.lastStudyDate;
            
            if (!lastStudy) {
                state.streak = 0;
            } else if (lastStudy === today) {
                // Already studied today
            } else {
                const yesterday = new Date();
                yesterday.setDate(yesterday.getDate() - 1);
                
                if (lastStudy === yesterday.toDateString()) {
                    // Studied yesterday, streak continues
                } else {
                    // Streak broken
                    state.streak = 0;
                }
            }
            saveState();
        }

        // Record study activity
        function recordStudy() {
            const today = new Date().toDateString();
            if (state.lastStudyDate !== today) {
                state.streak++;
                state.lastStudyDate = today;
                state.todayWords = 0;
                saveState();
                checkAchievements();
            }
        }

