        // Render levels grid
        function renderLevels() {
            const container = document.getElementById('levels-grid');
            container.innerHTML = '';
            
            APP_DATA.levels.forEach((level, index) => {
                // Calculate level progress
                let completedLessons = 0;
                level.lessons.forEach(lesson => {
                    if (state.lessonProgress[lesson.id] === 'completed') {
                        completedLessons++;
                    }
                });
                const progress = Math.round((completedLessons / level.lessons.length) * 100);
                
                // Check if level is locked
                const isLocked = index > 0 && getCompletedLessonsCount(APP_DATA.levels[index - 1]) < APP_DATA.levels[index - 1].lessons.length;
                
                const card = document.createElement('div');
                card.className = `level-card ${isLocked ? 'locked' : ''}`;
                card.innerHTML = `
                    <div class="level-badge ${level.color}">${level.id.toUpperCase()}</div>
                    <div class="level-name">${level.name}</div>
                    <div class="level-desc">${level.description}</div>
                    <div class="level-progress">
                        <div class="level-progress-bar">
                            <div class="level-progress-fill" style="width: ${progress}%"></div>
                        </div>
                        <span class="level-progress-text">${progress}%</span>
                    </div>
                    ${isLocked ? '<span class="lock-icon">🔒</span>' : ''}
                `;
                
                if (!isLocked) {
                    card.onclick = () => {
                        state.currentLevel = level;
                        renderLessons(level);
                        showPage('page-lessons');
                    };
                }
                
                container.appendChild(card);
            });
        }

        function getCompletedLessonsCount(level) {
            let count = 0;
            level.lessons.forEach(lesson => {
                if (state.lessonProgress[lesson.id] === 'completed') count++;
            });
            return count;
        }

        // Render lessons list
        function renderLessons(level) {
            document.getElementById('lessons-title').textContent = `📖 دروس ${level.name}`;
            const container = document.getElementById('lessons-list');
            container.innerHTML = '';
            
            level.lessons.forEach((lesson, index) => {
                const status = state.lessonProgress[lesson.id] || 'locked';
                const prevLesson = index > 0 ? level.lessons[index - 1] : null;
                
                // Unlock logic
                if (status === 'locked' && (!prevLesson || state.lessonProgress[prevLesson.id] === 'completed')) {
                    state.lessonProgress[lesson.id] = 'available';
                    saveState();
                }
                
                const currentStatus = state.lessonProgress[lesson.id];
                const iconBg = lesson.type === 'vocab' ? 'vocab' : lesson.type === 'grammar' ? 'grammar' : lesson.type === 'dialog' ? 'dialog' : 'exercise';
                
                const card = document.createElement('div');
                card.className = `lesson-card ${currentStatus}`;
                card.innerHTML = `
                    <div class="lesson-icon ${iconBg}">${lesson.icon}</div>
                    <div class="lesson-info">
                        <div class="lesson-title">${lesson.title}</div>
                        <div class="lesson-meta">
                            <span>📝 ${lesson.words} كلمة</span>
                            <span>⏱️ ${lesson.time} دقيقة</span>
                        </div>
                    </div>
                    <div class="lesson-status ${currentStatus}">
                        ${currentStatus === 'completed' ? '✓' : currentStatus === 'available' ? '▶' : '🔒'}
                    </div>
                `;
                
                if (currentStatus !== 'locked') {
                    card.onclick = () => {
                        state.currentLesson = lesson;
                        loadLessonWords(lesson.id);
                        showPage('page-words');
                    };
                }
                
                container.appendChild(card);
            });
        }

        // Render continue lesson on home
        function renderContinueLesson() {
            const container = document.getElementById('continue-lesson');
            
            // Find first available or in-progress lesson
            let currentLesson = null;
            let currentLevel = null;
            
            for (const level of APP_DATA.levels) {
                for (const lesson of level.lessons) {
                    const status = state.lessonProgress[lesson.id];
                    if (status === 'available') {
                        currentLesson = lesson;
                        currentLevel = level;
                        break;
                    }
                }
                if (currentLesson) break;
            }
            
            if (!currentLesson) {
                container.innerHTML = `
                    <div class="empty-state">
                        <div class="empty-icon">🎉</div>
                        <div class="empty-title">أحسنت!</div>
                        <div class="empty-text">لقد أكملت جميع الدروس المتاحة</div>
                    </div>
                `;
                return;
            }
            
            const iconBg = currentLesson.type === 'vocab' ? 'vocab' : currentLesson.type === 'grammar' ? 'grammar' : 'dialog';
            
            container.innerHTML = `
                <div class="lesson-card current" onclick="continueLearning()">
                    <div class="lesson-icon ${iconBg}">${currentLesson.icon}</div>
                    <div class="lesson-info">
                        <div class="lesson-title">${currentLesson.title}</div>
                        <div class="lesson-meta">
                            <span>📝 ${currentLesson.words} كلمة</span>
                            <span>⏱️ ${currentLesson.time} دقيقة</span>
                        </div>
                    </div>
                    <div class="lesson-status current">▶</div>
                </div>
            `;
            
            // Store for quick access
            state.currentLesson = currentLesson;
            state.currentLevel = currentLevel;
        }

        function continueLearning() {
            if (state.currentLesson) {
                loadLessonWords(state.currentLesson.id);
                showPage('page-words');
            }
        }

        // ============================================
        // 📝 WORDS & FLASHCARDS
        // ============================================

        let currentWords = [];

        function loadLessonWords(lessonId) {
            const words = APP_DATA.words[lessonId] || [];
            currentWords = [...words];
            state.currentWordIndex = 0;
            
            // Find lesson info
            for (const level of APP_DATA.levels) {
                const lesson = level.lessons.find(l => l.id === lessonId);
                if (lesson) {
                    state.currentLesson = lesson;
                    break;
                }
            }
            
            renderWordCategories();
            updateWordDisplay();
            updateWordsCount();
        }

        function renderWordCategories() {
            const container = document.getElementById('word-categories');
            container.innerHTML = `
                <div class="category-tab active" onclick="filterWords('all', this)">الكل</div>
                <div class="category-tab" onclick="filterWords('new', this)">جديدة</div>
                <div class="category-tab" onclick="filterWords('learning', this)">قيد التعلم</div>
                <div class="category-tab" onclick="filterWords('learned', this)">تم حفظها</div>
            `;
        }

        function filterWords(category, element) {
            // Update active tab
            document.querySelectorAll('.category-tab').forEach(t => t.classList.remove('active'));
            element.classList.add('active');
            
            state.currentCategory = category;
            state.currentWordIndex = 0;
            
            updateWordDisplay();
        }

        function getFilteredWords() {
            if (!state.currentLesson) return currentWords;
            
            const lessonId = state.currentLesson.id;
            const progress = state.wordProgress[lessonId] || {};
            
            return currentWords.filter((word, index) => {
                const wordState = progress[index];
                
                switch (state.currentCategory) {
                    case 'new':
                        return !wordState || wordState.level === 0;
                    case 'learning':
                        return wordState && wordState.level > 0 && wordState.level < 4;
                    case 'learned':
                        return wordState && wordState.level >= 4;
                    default:
                        return true;
                }
            });
        }

        function updateWordDisplay() {
            const filteredWords = getFilteredWords();
            
            if (state.wordView === 'flashcard') {
                renderFlashcard(filteredWords);
            } else {
                renderWordsList(filteredWords);
            }
            
            updateWordsCount();
        }

        function renderFlashcard(words) {
            if (words.length === 0) {
                document.getElementById('flashcard-view').innerHTML = `
                    <div class="empty-state">
                        <div class="empty-icon">📭</div>
                        <div class="empty-title">لا توجد كلمات</div>
                        <div class="empty-text">جرب تصنيف آخر</div>
                    </div>
                `;
                return;
            }
            
            // Reset flashcard view
            document.getElementById('flashcard-view').innerHTML = `
                <div class="flashcard-counter" id="flashcard-counter">1 / ${words.length}</div>
                <div class="flashcard-container">
                    <div class="flashcard" id="flashcard" onclick="flipCard()">
                        <div class="flashcard-face flashcard-front">
                            <div class="flashcard-word" id="fc-word"></div>
                            <div class="flashcard-pronunciation" id="fc-pronunciation"></div>
                            <div class="flashcard-hint">👆 اضغط لرؤية الترجمة</div>
                        </div>
                        <div class="flashcard-face flashcard-back">
                            <div class="flashcard-arabic" id="fc-arabic"></div>
                            <div class="flashcard-example" id="fc-example"></div>
                        </div>
                    </div>
                </div>
                <div class="flashcard-actions">
                    <button class="fc-btn wrong" onclick="rateWord(1)">
                        <span>❌</span>
                        <span>لم أعرف</span>
                    </button>
                    <button class="fc-btn hard" onclick="rateWord(2)">
                        <span>🤔</span>
                        <span>صعبة</span>
                    </button>
                    <button class="fc-btn good" onclick="rateWord(3)">
                        <span>😊</span>
                        <span>جيدة</span>
                    </button>
                    <button class="fc-btn easy" onclick="rateWord(4)">
                        <span>✅</span>
                        <span>سهلة</span>
                    </button>
                </div>
            `;
            
            const word = words[state.currentWordIndex];
            if (word) {
                document.getElementById('fc-word').textContent = word.it;
                document.getElementById('fc-pronunciation').textContent = word.pron;
                document.getElementById('fc-arabic').textContent = word.ar;
                document.getElementById('fc-example').innerHTML = `"${word.ex_it}"<br>${word.ex_ar}`;
                document.getElementById('flashcard-counter').textContent = `${state.currentWordIndex + 1} / ${words.length}`;
            }
        }

        function renderWordsList(words) {
            const container = document.getElementById('words-list');
            container.innerHTML = '';
            
            if (words.length === 0) {
                container.innerHTML = `
                    <div class="empty-state">
                        <div class="empty-icon">📭</div>
                        <div class="empty-title">لا توجد كلمات</div>
                        <div class="empty-text">جرب تصنيف آخر</div>
                    </div>
                `;
                return;
            }
            
            words.forEach((word, index) => {
                const lessonId = state.currentLesson?.id;
                const progress = state.wordProgress[lessonId] || {};
                const wordState = progress[currentWords.indexOf(word)];
                const isLearned = wordState && wordState.level >= 4;
                
                const card = document.createElement('div');
                card.className = `word-card ${isLearned ? 'learned' : ''}`;
                card.innerHTML = `
                    <div class="word-main">
                        <div class="word-italian">${word.it}</div>
                        <button class="word-audio-btn" onclick="playAudio('${word.it}')">🔊</button>
                    </div>
                    <div class="word-pronunciation">${word.pron}</div>
                    <div class="word-arabic">${word.ar}</div>
                    <div class="word-example">
                        <div class="word-example-it">"${word.ex_it}"</div>
                        <div class="word-example-ar">${word.ex_ar}</div>
                    </div>
                    <div class="word-actions">
                        <button class="word-btn secondary" onclick="playAudio('${word.it}')">
                            🔊 استمع
                        </button>
                        <button class="word-btn ${isLearned ? 'learned' : 'primary'}" onclick="markWordLearned(${currentWords.indexOf(word)})">
                            ${isLearned ? '✓ تم الحفظ' : '📝 حفظ'}
                        </button>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        function flipCard() {
            const flashcard = document.getElementById('flashcard');
            flashcard.classList.toggle('flipped');
        }

        function rateWord(rating) {
            const filteredWords = getFilteredWords();
            if (filteredWords.length === 0) return;
            
            const word = filteredWords[state.currentWordIndex];
            const originalIndex = currentWords.indexOf(word);
            const lessonId = state.currentLesson?.id;
            
            if (!lessonId) return;
            
            // Initialize progress objects
            if (!state.wordProgress[lessonId]) {
                state.wordProgress[lessonId] = {};
            }
            
            const current = state.wordProgress[lessonId][originalIndex] || { level: 0 };
            
            // Update level based on rating
            if (rating >= 3) {
                current.level = Math.min(5, current.level + 1);
                
                // First time learning this word
                if (current.level === 1) {
                    state.wordsLearned++;
                    state.todayWords++;
                    state.xp += 10;
                    recordStudy();
                } else {
                    state.xp += rating * 2;
                }
            } else {
                current.level = Math.max(0, current.level - 1);
            }
            
            state.wordProgress[lessonId][originalIndex] = current;
            saveState();
            
            // Check achievements
            checkAchievements();
            
            // Move to next word
            nextWord();
        }

        function nextWord() {
            const filteredWords = getFilteredWords();
            
            // Unflip card
            const flashcard = document.getElementById('flashcard');
            if (flashcard) flashcard.classList.remove('flipped');
            
            state.currentWordIndex++;
            
            if (state.currentWordIndex >= filteredWords.length) {
                // Lesson completed
                state.currentWordIndex = 0;
                
                if (state.currentLesson) {
                    state.lessonProgress[state.currentLesson.id] = 'completed';
                    state.lessonsCompleted++;
                    state.xp += 50;
                    saveState();
                    
                    showModal('🎉', 'أحسنت!', 'لقد أكملت هذا الدرس بنجاح!');
                    checkAchievements();
                }
            }
            
            updateWordDisplay();
            updateStats();
        }

        function markWordLearned(index) {
            const lessonId = state.currentLesson?.id;
            if (!lessonId) return;
            
            if (!state.wordProgress[lessonId]) {
                state.wordProgress[lessonId] = {};
            }
            
            const current = state.wordProgress[lessonId][index] || { level: 0 };
            
            if (current.level < 4) {
                current.level = 4;
                state.wordsLearned++;
                state.todayWords++;
                state.xp += 15;
                recordStudy();
                
                showToast('تم حفظ الكلمة ✓', 'success');
            }
            
            state.wordProgress[lessonId][index] = current;
            saveState();
            updateStats();
            updateWordDisplay();
            checkAchievements();
        }

        function setWordView(view) {
            state.wordView = view;
            
            document.getElementById('btn-flashcard').classList.toggle('active', view === 'flashcard');
            document.getElementById('btn-list').classList.toggle('active', view === 'list');
            
            document.getElementById('flashcard-view').style.display = view === 'flashcard' ? 'block' : 'none';
            document.getElementById('list-view').style.display = view === 'list' ? 'block' : 'none';
            
            updateWordDisplay();
        }

        function updateWordsCount() {
            const count = getFilteredWords().length;
            document.getElementById('words-count').textContent = `${count} كلمة`;
            
            if (state.currentLesson) {
                document.getElementById('words-title').textContent = state.currentLesson.title;
            }
        }

        function playAudio(text) {
            if ('speechSynthesis' in window) {
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'it-IT';
                utterance.rate = 0.8;
                speechSynthesis.speak(utterance);
            }
        }

        // ============================================
        // 🎯 QUIZ SYSTEM
        // ============================================

        function startQuiz() {
            // Collect all learned words
            let allWords = [];
            
            Object.keys(state.wordProgress).forEach(lessonId => {
                const words = APP_DATA.words[lessonId] || [];
                const progress = state.wordProgress[lessonId];
                
                words.forEach((word, index) => {
                    if (progress[index] && progress[index].level > 0) {
                        allWords.push(word);
                    }
                });
            });
            
            // If not enough learned words, use first lesson words
            if (allWords.length < 4) {
                allWords = APP_DATA.words['a1-1'] || [];
            }
            
            // Shuffle and select questions
            allWords = shuffleArray(allWords);
            const questionCount = Math.min(10, allWords.length);
            
            state.quizQuestions = [];
            state.quizCurrentIndex = 0;
            state.quizScore = 0;
            state.quizAnswers = [];
            
            for (let i = 0; i < questionCount; i++) {
                const word = allWords[i];
                const questionType = Math.random() > 0.5 ? 'it-to-ar' : 'ar-to-it';
                
                // Generate wrong options
                const wrongOptions = allWords
                    .filter(w => w.it !== word.it)
                    .sort(() => Math.random() - 0.5)
                    .slice(0, 3);
                
                let options;
                if (questionType === 'it-to-ar') {
                    options = shuffleArray([
                        { text: word.ar, correct: true },
                        ...wrongOptions.map(w => ({ text: w.ar, correct: false }))
                    ]);
                } else {
                    options = shuffleArray([
                        { text: word.it, correct: true },
                        ...wrongOptions.map(w => ({ text: w.it, correct: false }))
                    ]);
                }
                
                state.quizQuestions.push({
                    word,
                    type: questionType,
                    options
                });
            }
            
            renderQuiz();
        }

        function renderQuiz() {
            document.getElementById('quiz-container').style.display = 'block';
            document.getElementById('quiz-result').style.display = 'none';
            
            const question = state.quizQuestions[state.quizCurrentIndex];
            if (!question) {
                showQuizResult();
                return;
            }
            
            // Render progress dots
            const progressContainer = document.getElementById('quiz-progress');
            progressContainer.innerHTML = state.quizQuestions.map((_, i) => {
                let className = 'quiz-dot';
                if (i < state.quizCurrentIndex) {
                    className += state.quizAnswers[i] ? ' done' : ' wrong';
                } else if (i === state.quizCurrentIndex) {
                    className += ' current';
                }
                return `<div class="${className}"></div>`;
            }).join('');
            
            // Render question
            document.getElementById('quiz-score').textContent = `⭐ ${state.quizScore}`;
            
            if (question.type === 'it-to-ar') {
                document.getElementById('quiz-type').textContent = 'ما معنى هذه الكلمة؟';
                document.getElementById('quiz-question').textContent = question.word.it;
                document.getElementById('quiz-question').style.fontFamily = 'var(--font-en)';
            } else {
                document.getElementById('quiz-type').textContent = 'كيف تقول هذه الكلمة بالإيطالية؟';
                document.getElementById('quiz-question').textContent = question.word.ar;
                document.getElementById('quiz-question').style.fontFamily = 'var(--font-ar)';
            }
            
            // Render options
            const optionsContainer = document.getElementById('quiz-options');
            const letters = ['أ', 'ب', 'ج', 'د'];
            
            optionsContainer.innerHTML = question.options.map((opt, i) => `
                <div class="quiz-option" onclick="selectQuizOption(${i})" data-index="${i}">
                    <span class="quiz-option-letter">${letters[i]}</span>
                    <span class="quiz-option-text">${opt.text}</span>
                </div>
            `).join('');
            
            // Reset button
            state.selectedOption = null;
            document.getElementById('quiz-btn').disabled = true;
            document.getElementById('quiz-btn').textContent = 'تحقق';
            document.getElementById('quiz-btn').onclick = checkAnswer;
        }

        function selectQuizOption(index) {
            // Clear previous selection
            document.querySelectorAll('.quiz-option').forEach(opt => {
                opt.classList.remove('selected', 'correct', 'wrong');
            });
            
            // Select new option
            const option = document.querySelector(`.quiz-option[data-index="${index}"]`);
            option.classList.add('selected');
            
            state.selectedOption = index;
            document.getElementById('quiz-btn').disabled = false;
        }

        function checkAnswer() {
            if (state.selectedOption === null) return;
            
            const question = state.quizQuestions[state.quizCurrentIndex];
            const isCorrect = question.options[state.selectedOption].correct;
            
            // Show correct/wrong
            document.querySelectorAll('.quiz-option').forEach((opt, i) => {
                if (question.options[i].correct) {
                    opt.classList.add('correct');
                } else if (i === state.selectedOption && !isCorrect) {
                    opt.classList.add('wrong');
                }
            });
            
            // Update score
            if (isCorrect) {
                state.quizScore += 10;
                state.correctAnswers++;
                state.xp += 5;
            }
            state.quizAnswers.push(isCorrect);
            
            saveState();
            
            // Update button
            document.getElementById('quiz-btn').textContent = 'التالي';
            document.getElementById('quiz-btn').onclick = nextQuestion;
            document.getElementById('quiz-score').textContent = `⭐ ${state.quizScore}`;
        }

        function nextQuestion() {
            state.quizCurrentIndex++;
            state.selectedOption = null;
            
            if (state.quizCurrentIndex >= state.quizQuestions.length) {
                showQuizResult();
            } else {
                renderQuiz();
            }
        }

        function showQuizResult() {
            document.getElementById('quiz-container').style.display = 'none';
            document.getElementById('quiz-result').style.display = 'block';
            
            const correctCount = state.quizAnswers.filter(a => a).length;
            const percentage = Math.round((correctCount / state.quizQuestions.length) * 100);
            
            let icon, title;
            if (percentage >= 80) {
                icon = '🏆';
                title = 'ممتاز!';
            } else if (percentage >= 60) {
                icon = '🎉';
                title = 'أحسنت!';
            } else if (percentage >= 40) {
                icon = '💪';
                title = 'جيد!';
            } else {
                icon = '📚';
                title = 'تحتاج مراجعة';
            }
            
            document.getElementById('result-icon').textContent = icon;
            document.getElementById('result-title').textContent = title;
            document.getElementById('result-subtitle').textContent = `أجبت ${correctCount} من ${state.quizQuestions.length} بشكل صحيح`;
            document.getElementById('result-correct').textContent = correctCount;
            document.getElementById('result-xp').textContent = `+${state.quizScore}`;
            
            recordStudy();
            checkAchievements();
            updateStats();
        }

        function restartQuiz() {
            startQuiz();
        }

        function exitQuiz() {
            showPage('page-home');
        }

        // ============================================
        // 🏆 ACHIEVEMENTS
        // ============================================

        function checkAchievements() {
            const stats = {
                wordsLearned: state.wordsLearned,
                lessonsCompleted: state.lessonsCompleted,
                streak: state.streak,
                xp: state.xp,
                correctAnswers: state.correctAnswers
            };
            
            APP_DATA.achievements.forEach(achievement => {
                if (!state.achievements.includes(achievement.id) && achievement.condition(stats)) {
                    state.achievements.push(achievement.id);
                    state.xp += 25;
                    saveState();
                    
                    showModal(achievement.icon, 'إنجاز جديد!', `حصلت على: ${achievement.name}`);
                }
            });
            
            renderAchievements();
        }

        function renderAchievements() {
            const container = document.getElementById('achievements-grid');
            container.innerHTML = '';
            
            APP_DATA.achievements.forEach(achievement => {
                const earned = state.achievements.includes(achievement.id);
                
                const div = document.createElement('div');
                div.className = 'achievement';
                div.innerHTML = `
                    <div class="achievement-icon ${earned ? 'earned' : 'locked'}">
                        ${achievement.icon}
                    </div>
                    <div class="achievement-name">${achievement.name}</div>
                `;
                container.appendChild(div);
            });
        }

        // ============================================
        // ⚙️ SETTINGS
        // ============================================

        function changeDailyGoal(value) {
            state.dailyGoal = parseInt(value);
            saveState();
            updateStats();
            showToast('تم تحديث الهدف اليومي', 'success');
        }

        function toggleNotification() {
            const toggle = document.getElementById('notification-toggle');
            state.notifications = !state.notifications;
            toggle.classList.toggle('active', state.notifications);
            saveState();
            
            if (state.notifications) {
                showToast('تم تفعيل التذكيرات', 'success');
            } else {
                showToast('تم إيقاف التذكيرات', 'success');
            }
        }

        function resetProgress() {
            if (confirm('هل أنت متأكد من حذف جميع بياناتك؟ لا يمكن التراجع عن هذا الإجراء.')) {
                localStorage.removeItem('italiano_app_state');
                location.reload();
            }
        }

        // ============================================
        // 🔧 UTILITIES
        // ============================================

        function shuffleArray(array) {
            const newArray = [...array];
            for (let i = newArray.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [newArray[i], newArray[j]] = [newArray[j], newArray[i]];
            }
            return newArray;
        }

        function showPage(pageId, navItem) {
            // Hide all pages
            document.querySelectorAll('.page').forEach(page => {
                page.classList.remove('active');
            });
            
            // Show selected page
            document.getElementById(pageId).classList.add('active');
            
            // Update navigation
            document.querySelectorAll('.nav-item').forEach(item => {
                item.classList.remove('active');
                if (item.dataset.page === pageId) {
                    item.classList.add('active');
                }
            });
            
            if (navItem) {
                document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
                navItem.classList.add('active');
            }
            
            // Scroll to top
            window.scrollTo(0, 0);
            
            // Page-specific actions
            if (pageId === 'page-home') {
                renderLevels();
                renderContinueLesson();
                updateStats();
            } else if (pageId === 'page-words' && !state.currentLesson) {
                // Load first available lesson
                for (const level of APP_DATA.levels) {
                    for (const lesson of level.lessons) {
                        if (state.lessonProgress[lesson.id] !== 'locked') {
                            loadLessonWords(lesson.id);
                            return;
                        }
                    }
                }
            } else if (pageId === 'page-profile') {
                renderAchievements();
                updateStats();
            }
        }

        function showToast(message, type = 'success') {
            const toast = document.getElementById('toast');
            document.getElementById('toast-message').textContent = message;
            document.getElementById('toast-icon').textContent = type === 'success' ? '✓' : '✕';
            
            toast.className = `toast ${type} show`;
            
            setTimeout(() => {
                toast.classList.remove('show');
            }, 3000);
        }

        function showModal(icon, title, text) {
            document.getElementById('modal-icon').textContent = icon;
            document.getElementById('modal-title').textContent = title;
            document.getElementById('modal-text').textContent = text;
            document.getElementById('modal-overlay').classList.add('show');
        }

        function closeModal() {
            document.getElementById('modal-overlay').classList.remove('show');
        }

        // ============================================
        // 🚀 INITIALIZATION
        // ============================================

        document.addEventListener('DOMContentLoaded', () => {
            loadState();
            renderLevels();
            renderContinueLesson();
            renderAchievements();
            updateStats();
            
            // Initialize notification toggle state
            if (state.notifications) {
                document.getElementById('notification-toggle').classList.add('active');
            }
            
            console.log('🇮🇹 Italiano App initialized!');
        });
    </script>

