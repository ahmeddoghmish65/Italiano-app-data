                            { it: 'Pizza', ar: 'بيتزا', phonetic: '/ˈpittsa/', type: 'اسم', example: { it: 'La pizza è buona.', ar: 'البيتزا لذيذة.' } },
                            { it: 'Pasta', ar: 'معكرونة', phonetic: '/ˈpasta/', type: 'اسم', example: { it: 'Mi piace la pasta.', ar: 'أحب المعكرونة.' } },
