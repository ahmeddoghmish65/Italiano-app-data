            currentIndex: 0,
            score: 0,
            hearts: 5,
            answered: false,
            type: 'vocab'
        };

        function startQuiz(type) {
            quizState = {
                questions: generateQuestions(type, 5),
                currentIndex: 0,
                score: 0,
                hearts: appData.user.hearts,
                answered: false,
                type: type
            };
            
            document.getElementById('quizTitle').textContent = getQuizTitle(type);
            document.getElementById('quizModal').classList.add('active');
            renderQuestion();
        }

        function getQuizTitle(type) {
