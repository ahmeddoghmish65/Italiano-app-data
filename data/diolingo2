                'vocab': 'اختبار المفردات',
                'listen': 'اختبار الاستماع',
                'write': 'اختبار الكتابة'
            };
            return titles[type] || 'اختبار';
        }

        function generateQuestions(type, count) {
            const vocab = [...appData.vocabulary].sort(() => Math.random() - 0.5).slice(0, count);
            
            return vocab.map(word => {
                const wrongAnswers = appData.vocabulary
                    .filter(w => w.ar !== word.ar)
                    .sort(() => Math.random() - 0.5)
                    .slice(0, 3)
                    .map(w => w.ar);
                
                const options = [word.ar, ...wrongAnswers].sort(() => Math.random() - 0.5);
                
                return {
                    word: word.it,
                    correct: word.ar,
                    options: options,
                    type: type
                };
            });
        }

        function renderQuestion() {
            const q = quizState.questions[quizState.currentIndex];
            const body = document.getElementById('quizBody');
            
            // Progress dots
            let progressHTML = '<div class="quiz-progress">';
            quizState.questions.forEach((_, i) => {
                let dotClass = 'quiz-progress-dot';
                if (i < quizState.currentIndex) dotClass += ' completed';
                if (i === quizState.currentIndex) dotClass += ' current';
                progressHTML += `<div class="${dotClass}"></div>`;
            });
            progressHTML += '</div>';
            
            // Hearts
            let heartsHTML = '<div class="quiz-hearts">';
            for (let i = 0; i < 5; i++) {
                heartsHTML += `<i class="fa-solid fa-heart quiz-heart ${i >= quizState.hearts ? 'lost' : ''}"></i>`;
            }
            heartsHTML += '</div>';
            
            // Question
            let questionHTML = `
                ${progressHTML}
                ${heartsHTML}
                <div class="quiz-question">ما معنى هذه الكلمة؟</div>
                <div class="quiz-word">${q.word}</div>
            `;
            
            // Play audio for listening quiz
            if (q.type === 'listen') {
                speakWord(q.word);
                questionHTML = `
                    ${progressHTML}
                    ${heartsHTML}
                    <div class="quiz-question">استمع واختر الترجمة الصحيحة</div>
                    <div style="text-align: center; margin: 20px 0;">
                        <button class="btn btn-secondary" style="width: auto; display: inline-flex; align-items: center; gap: 10px;" onclick="speakWord('${q.word}')">
                            <i class="fa-solid fa-volume-high"></i> استمع مرة أخرى
                        </button>
                    </div>
                `;
            }
            
            // Options
            questionHTML += '<div class="quiz-options">';
            q.options.forEach((opt, i) => {
                questionHTML += `<div class="quiz-option" onclick="selectAnswer(${i}, '${opt}')">${opt}</div>`;
            });
            questionHTML += '</div>';
            
            body.innerHTML = questionHTML;
            
            // Reset button
            quizState.answered = false;
            document.getElementById('quizNextBtn').disabled = true;
        }

        function selectAnswer(index, answer) {
            if (quizState.answered) return;
            quizState.answered = true;
            
            const q = quizState.questions[quizState.currentIndex];
            const options = document.querySelectorAll('.quiz-option');
            
            options.forEach((opt, i) => {
                if (opt.textContent === q.correct) {
                    opt.classList.add('correct');
                } else if (i === index && answer !== q.correct) {
                    opt.classList.add('wrong');
                }
            });
            
            if (answer === q.correct) {
                quizState.score++;
                showToast('إجابة صحيحة! 🎉', 'success');
            } else {
                quizState.hearts--;
                appData.user.hearts--;
                updateStats();
                showToast('إجابة خاطئة 😔', 'error');
                
                // Save mistake
                appData.mistakes.push(q.word);
                
                if (quizState.hearts <= 0) {
                    setTimeout(() => showResult(false), 1000);
                    return;
                }
            }
            
            document.getElementById('quizNextBtn').disabled = false;
        }

        function nextQuestion() {
            quizState.currentIndex++;
            
            if (quizState.currentIndex >= quizState.questions.length) {
                showResult(true);
            } else {
                renderQuestion();
            }
        }

        function showResult(completed) {
            closeQuiz();
            
            const xpEarned = quizState.score * 10;
            const accuracy = Math.round((quizState.score / quizState.questions.length) * 100);
            
            // Update user data
            appData.user.xp += xpEarned;
            updateStats();
            
            const resultScreen = document.getElementById('resultScreen');
            
            if (completed && quizState.score === quizState.questions.length) {
                // Perfect score
                resultScreen.innerHTML = `
                    <div class="result-icon">🎉</div>
                    <div class="result-title" style="color: var(--primary);">ممتاز!</div>
                    <div class="result-subtitle">أجبت على جميع الأسئلة بشكل صحيح</div>
                    <div class="result-stats">
                        <div class="result-stat">
                            <div class="result-stat-value">${xpEarned}</div>
                            <div class="result-stat-label">نقاط XP</div>
                        </div>
                        <div class="result-stat">
                            <div class="result-stat-value">${accuracy}%</div>
                            <div class="result-stat-label">دقة</div>
                        </div>
                    </div>
                    <button class="btn btn-primary" onclick="closeResult()">متابعة</button>
                `;
                createConfetti();
            } else if (completed) {
                // Completed but not perfect
                resultScreen.innerHTML = `
                    <div class="result-icon">👍</div>
                    <div class="result-title" style="color: var(--secondary);">أحسنت!</div>
                    <div class="result-subtitle">أكملت الاختبار بنجاح</div>
                    <div class="result-stats">
                        <div class="result-stat">
                            <div class="result-stat-value">${quizState.score}/${quizState.questions.length}</div>
                            <div class="result-stat-label">إجابات صحيحة</div>
                        </div>
                        <div class="result-stat">
                            <div class="result-stat-value">${xpEarned}</div>
                            <div class="result-stat-label">نقاط XP</div>
                        </div>
                    </div>
                    <button class="btn btn-primary" onclick="closeResult()">متابعة</button>
                    <button class="btn btn-outline" onclick="closeResult(); startQuiz('${quizState.type}')">إعادة المحاولة</button>
                `;
            } else {
                // Failed (no hearts)
                resultScreen.innerHTML = `
                    <div class="result-icon">💔</div>
                    <div class="result-title" style="color: var(--danger);">انتهت القلوب!</div>
                    <div class="result-subtitle">حاول مرة أخرى لاحقاً</div>
                    <div class="result-stats">
                        <div class="result-stat">
                            <div class="result-stat-value">${quizState.score}/${quizState.questions.length}</div>
                            <div class="result-stat-label">إجابات صحيحة</div>
                        </div>
                    </div>
                    <button class="btn btn-primary" onclick="closeResult()">العودة</button>
                `;
            }
            
            document.getElementById('resultModal').classList.add('active');
            
            // Show XP animation
            if (xpEarned > 0) {
                showXPGain(xpEarned);
            }
        }

        function closeQuiz() {
            document.getElementById('quizModal').classList.remove('active');
        }

        function closeResult() {
            document.getElementById('resultModal').classList.remove('active');
        }

        // ==================== البطاقات التعليمية ====================
        let flashcardState = {
            cards: [],
            currentIndex: 0
        };

        function openFlashcards() {
            flashcardState.cards = [...appData.vocabulary].sort(() => Math.random() - 0.5);
            flashcardState.currentIndex = 0;
            
            updateFlashcard();
            document.getElementById('flashcardsModal').classList.add('active');
        }

        function closeFlashcards() {
            document.getElementById('flashcardsModal').classList.remove('active');
            document.getElementById('flashcard').classList.remove('flipped');
        }

        function updateFlashcard() {
            const card = flashcardState.cards[flashcardState.currentIndex];
            document.getElementById('flashcardFront').textContent = card.it;
            document.getElementById('flashcardBack').textContent = card.ar;
            document.getElementById('flashcardCounter').textContent = 
                `${flashcardState.currentIndex + 1} / ${flashcardState.cards.length}`;
            document.getElementById('flashcard').classList.remove('flipped');
        }

        function flipCard() {
            document.getElementById('flashcard').classList.toggle('flipped');
            speakWord(flashcardState.cards[flashcardState.currentIndex].it);
        }

        function nextFlashcard() {
            if (flashcardState.currentIndex < flashcardState.cards.length - 1) {
                flashcardState.currentIndex++;
                updateFlashcard();
            } else {
                showToast('أكملت جميع البطاقات! 🎉', 'success');
                closeFlashcards();
            }
        }

        function prevFlashcard() {
            if (flashcardState.currentIndex > 0) {
                flashcardState.currentIndex--;
                updateFlashcard();
            }
        }

        // ==================== التحديات ====================
        function startChallenge() {
            quizState = {
                questions: generateQuestions('vocab', 10),
                currentIndex: 0,
                score: 0,
                hearts: 1, // Only one heart for challenge
                answered: false,
                type: 'challenge'
            };
            
            document.getElementById('quizTitle').textContent = '🏆 تحدي الـ 10 كلمات';
            document.getElementById('quizModal').classList.add('active');
            renderQuestion();
        }

        function reviewMistakes() {
            if (appData.mistakes.length === 0) {
                showToast('لا توجد أخطاء للمراجعة!', 'info');
                return;
            }
            
            showToast('مراجعة الأخطاء...', 'info');
            startQuiz('vocab');
        }

        // ==================== النطق ====================
        function speakWord(word) {
            if ('speechSynthesis' in window) {
                const utterance = new SpeechSynthesisUtterance(word);
                utterance.lang = 'it-IT';
                utterance.rate = 0.8;
                speechSynthesis.speak(utterance);
            }
        }

        // ==================== تحديث الإحصائيات ====================
        function updateStats() {
            document.getElementById('streakCount').textContent = appData.user.streak;
            document.getElementById('gemsCount').textContent = appData.user.gems;
            document.getElementById('heartsCount').textContent = appData.user.hearts;
            
            // Profile stats
            document.getElementById('profileStreak').textContent = appData.user.streak;
            document.getElementById('profileXP').textContent = appData.user.xp;
            document.getElementById('profileWords').textContent = appData.user.wordsLearned;
            document.getElementById('profileLessons').textContent = appData.user.lessonsCompleted;
            
            // Save to localStorage
            saveData();
        }

        // ==================== التخزين المحلي ====================
        function saveData() {
            localStorage.setItem('italianoHubData', JSON.stringify(appData));
        }

        function loadData() {
            const saved = localStorage.getItem('italianoHubData');
            if (saved) {
                const parsed = JSON.parse(saved);
                Object.assign(appData, parsed);
                updateStats();
            }
        }

        // ==================== الإشعارات ====================
        function showToast(message, type = 'info') {
            const toast = document.getElementById('toast');
            toast.textContent = message;
            toast.className = `toast ${type} show`;
            
            setTimeout(() => {
                toast.classList.remove('show');
            }, 3000);
        }

        // ==================== تأثير XP ====================
        function showXPGain(amount) {
            const xp = document.createElement('div');
            xp.className = 'xp-gain';
            xp.textContent = `+${amount} XP`;
            document.body.appendChild(xp);
            
            setTimeout(() => xp.remove(), 1000);
        }

        // ==================== تأثير الاحتفال ====================
        function createConfetti() {
            const colors = ['#58CC02', '#1CB0F6', '#FF9600', '#FF4B4B', '#CE82FF'];
            
            for (let i = 0; i < 50; i++) {
                const confetti = document.createElement('div');
                confetti.className = 'confetti';
                confetti.style.left = Math.random() * 100 + 'vw';
                confetti.style.top = '-10px';
                confetti.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
                confetti.style.borderRadius = Math.random() > 0.5 ? '50%' : '0';
                document.body.appendChild(confetti);
                
                const animation = confetti.animate([
                    { transform: 'translateY(0) rotate(0deg)', opacity: 1 },
                    { transform: `translateY(100vh) rotate(${Math.random() * 720}deg)`, opacity: 0 }
                ], {
                    duration: 2000 + Math.random() * 1000,
                    easing: 'cubic-bezier(0.25, 0.46, 0.45, 0.94)'
                });
                
                animation.onfinish = () => confetti.remove();
            }
        }

        // ==================== استعادة القلوب ====================
        function restoreHearts() {
            if (appData.user.hearts < appData.user.maxHearts) {
                appData.user.hearts = appData.user.maxHearts;
                updateStats();
                showToast('تم استعادة القلوب! ❤️', 'success');
            }
        }

        // Check hearts restoration every minute
        setInterval(() => {
            if (appData.user.hearts < appData.user.maxHearts) {
                appData.user.hearts++;
                updateStats();
            }
        }, 60000); // Restore 1 heart every minute

        // ==================== تهيئة التطبيق ====================
        document.addEventListener('DOMContentLoaded', () => {
            loadData();
            updateStats();
            
            // Check daily streak
            const lastVisit = localStorage.getItem('lastVisit');
            const today = new Date().toDateString();
            
            if (lastVisit !== today) {
                localStorage.setItem('lastVisit', today);
                if (lastVisit) {
                    const last = new Date(lastVisit);
                    const diff = Math.floor((new Date() - last) / (1000 * 60 * 60 * 24));
                    
                    if (diff === 1) {
                        appData.user.streak++;
                        showToast(`🔥 ${appData.user.streak} أيام متتالية!`, 'success');
                    } else if (diff > 1) {
                        appData.user.streak = 1;
                        showToast('مرحباً بعودتك! ابدأ سلسلة جديدة 🔥', 'info');
                    }
                    updateStats();
                }
            }
        });

        // Prevent pull-to-refresh on mobile
        document.body.addEventListener('touchmove', (e) => {
            if (e.target.closest('.modal-body')) return;
        }, { passive: false });
    </script>
</body>
</html>